// Combine API soccer matches with Australian sport fixtures
const allMatches: MatchDetail[] = [
  ...comprehensiveMatches.slice(0, 4),
  ...realApiMatches,
  ...comprehensiveMatches.slice(4)
];

const categories = [
  { id: 'all', label: 'All Live Sports', count: allMatches.length },
  { id: 'nrl', label: '🏉 NRL Premiership', count: allMatches.filter(m => m.sport === 'nrl').length },
  { id: 'afl', label: '🏉 AFL Premiership', count: allMatches.filter(m => m.sport === 'afl').length },
  { id: 'epl', label: '⚽ Premier League', count: allMatches.filter(m => m.sport === 'epl').length },
  { id: 'cricket', label: '🏏 Cricket & Ashes', count: allMatches.filter(m => m.sport === 'cricket').length },
  { id: 'ufc', label: '🥊 UFC & PPV', count: allMatches.filter(m => m.sport === 'ufc').length },
  { id: 'motorsport', label: '🏎️ Supercars & F1', count: allMatches.filter(m => m.sport === 'motorsport').length },
  { id: 'ucl', label: '🏆 Champions League', count: allMatches.filter(m => m.sport === 'ucl').length },
];

const trialUrl = "https://wa.me/18036582620?text=G%27day%21+I+am+in+the+AU+IPTV+Match+Center+and+want+a+free+24h+pass+to+watch+live+sports+in+4K.";

// Schema: SportsEvent ItemList & FAQPage for Google Search Rich Results
const matchCenterSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Live Australian Sports Schedule & IPTV 4K Feeds",
    "description": "Real-time scores and broadcast schedule for NRL, AFL, Premier League, Cricket, and UFC in Australia.",
    "itemListElement": allMatches.slice(0, 8).map((match, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "item": {
        "@type": "SportsEvent",
        "name": `${match.homeTeam} vs ${match.awayTeam}`,
        "description": `${match.league} live in 4K 60FPS on AU IPTV (${match.channel})`,
        "sport": match.league,
        "location": {
          "@type": "Place",
          "name": match.venue,
          "address": {
            "@type": "PostalAddress",
            "addressLocality": match.city,
            "addressCountry": "Australia"
          }
        },
        "competitor": [
          { "@type": "SportsTeam", "name": match.homeTeam },
          { "@type": "SportsTeam", "name": match.awayTeam }
        ]
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can I watch live NRL and AFL in 4K on AU IPTV?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. AU IPTV delivers dedicated 50FPS and 60FPS stadium feeds for every NRL Premiership match and AFL fixture in native 4K Ultra HD. Our local Sydney and Melbourne edge servers bypass ISP peak evening throttling with Anti-Freeze 9.8™ technology."
        }
      },
      {
        "@type": "Question",
        "name": "Are UFC, Boxing, and pay-per-view fights included?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "All major UFC numbered events, title fights, and Australian international boxing bouts (Main Event) are included with your AU IPTV subscription at zero additional charge. You never have to pay $59.95 AUD per fight."
        }
      },
      {
        "@type": "Question",
        "name": "How does 7-day catch-up work for late-night European football?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Because Premier League and Champions League fixtures kick off between 1:00 AM and 5:00 AM Australian time, our system records every match automatically for 7 days. You can wake up, make coffee, and watch the full match in 4K without having stayed up."
        }
      },
      {
        "@type": "Question",
        "name": "How do I start streaming a live match right now?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Message our 24/7 Australian WhatsApp support desk. We generate your Xtream API credentials in under 120 seconds with a free 24-hour testing pass so you can watch your chosen fixture immediately."
        }
      }
    ]
  }
];
---

<Layout
  title={`Live Scores & Sports Match Center Australia ${currentYear} — NRL, AFL, EPL & UFC in 4K | AU IPTV`}
  description="Live Australian sports scores, fixture schedule & real-time telemetry. Stream NRL, AFL, Premier League, Ashes Cricket & UFC in 4K 60FPS with Anti-Freeze 9.8™ domestic routing."
  keywords={[
    'iptv livescore australia',
    'live sports match center australia',
    'nrl live scores iptv',
    'afl live scores iptv',
    'epl live stream australia',
    'watch nrl 4k 60fps',
    'ufc ppv stream australia',
    `australian sports iptv ${currentYear}`
  ]}
  canonicalURL="https://au-iptv.net/livescore"
  schema={matchCenterSchema}
>
  <StickyHeader currentPath="/livescore" />

  <main id="main-content" class="flex-1 flex flex-col bg-[#060609] text-gray-200">
    
    <!-- Breadcrumbs Navigation -->
    <nav class="bg-[#0B0B12] border-b border-white/[0.06] py-3 text-xs text-gray-400" aria-label="Breadcrumb">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/iptv-sports" class="hover:text-white transition-colors">Sports 4K</a>
        <span>/</span>
        <span class="text-[#34D399] font-medium">Live Match Center</span>
      </div>
    </nav>

    <!-- Match Center Hero Header -->
    <section class="py-12 md:py-16 bg-gradient-to-b from-[#060609] via-[#0D0D14] to-[#060609] border-b border-white/[0.08] relative overflow-hidden">
      <!-- Glow Gradients -->
      <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 w-[850px] h-[320px] bg-gradient-to-b from-[#059669]/20 via-transparent to-transparent blur-3xl"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-5">
          <Radio class="w-3.5 h-3.5 text-[#10B981] animate-pulse" />
          <span>Real-Time Sports Telemetry &bull; 60FPS Australian CDN</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight mb-4">
          Australian & Global <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">Live Match Center</span>
        </h1>

        <p class="text-gray-300 text-sm sm:text-base md:text-lg max-w-3xl mx-auto leading-relaxed mb-8">
          Follow real-time scores, verified Australian stadium feeds, and kickoff schedules. Every fixture below is broadcast in native <strong>4K UHD 60FPS</strong> with zero buffering on AU IPTV.
        </p>

        <!-- Live Server Telemetry Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-4xl mx-auto">
          <div class="bg-[#0D0D14]/90 rounded-xl p-3.5 border border-white/[0.08] text-center shadow">
            <span class="text-[11px] text-gray-400 block font-mono">Telemetry Clock (AEST)</span>
            <span id="aest-clock" class="text-sm sm:text-base font-bold text-white font-mono">--:--:-- AEST</span>
          </div>

          <div class="bg-[#0D0D14]/90 rounded-xl p-3.5 border border-white/[0.08] text-center shadow">
            <span class="text-[11px] text-gray-400 block font-mono">Domestic CDN POPs</span>
            <span class="text-sm sm:text-base font-bold text-[#34D399] font-mono flex items-center justify-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#10B981] animate-ping"></span>
              <span>SYD • MEL • BNE</span>
            </span>
          </div>

          <div class="bg-[#0D0D14]/90 rounded-xl p-3.5 border border-white/[0.08] text-center shadow">
            <span class="text-[11px] text-gray-400 block font-mono">Average Latency</span>
            <span class="text-sm sm:text-base font-bold text-[#FDE047] font-mono">&lt; 12ms (Telstra/Optus)</span>
          </div>

          <div class="bg-[#0D0D14]/90 rounded-xl p-3.5 border border-white/[0.08] text-center shadow">
            <span class="text-[11px] text-gray-400 block font-mono">Frame Rate Engine</span>
            <span class="text-sm sm:text-base font-bold text-white font-mono">60FPS Anti-Freeze™</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Main Match Center Directory & Interactive Tabs -->
    <section class="py-12 md:py-16" aria-label="Live Match Directory">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- League Filter Chips -->
        <div class="flex items-center justify-between flex-wrap gap-4 mb-8">
          <div>
            <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
              <Trophy class="w-5 h-5 text-[#FDE047]" />
              <span>Today's Live & Upcoming Fixtures</span>
            </h2>
            <p class="text-xs text-gray-400 mt-1">
              Select a league to filter. Click any match card to launch a 4K live stream via WhatsApp.
            </p>
          </div>

          <div class="flex items-center gap-2">
            <a
              href={trialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#059669] hover:bg-[#047857] text-white font-bold text-xs shadow-[0_0_15px_rgba(5,150,105,0.3)] transition-all"
            >
              <Zap class="w-4 h-4 text-[#FDE047]" />
              <span>Get 24H Sports Pass ($0)</span>
            </a>
          </div>
        </div>

        <!-- Sport Category Pills -->
        <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 scrollbar-none" id="sport-filters" role="tablist">
          {categories.map((cat, idx) => (
            <button
              type="button"
              role="tab"
              data-filter={cat.id}
              class={`filter-tab px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap flex items-center gap-2 cursor-pointer border ${
                idx === 0
                  ? 'active-tab bg-[#059669] text-white border-[#059669] shadow-[0_0_15px_rgba(5,150,105,0.3)]'
                  : 'bg-[#0D0D14] text-gray-300 border-white/[0.08] hover:border-[#059669]/50 hover:text-white'
              }`}
            >
              <span>{cat.label}</span>
              <span class="text-[10px] px-1.5 py-0.2 rounded-full bg-white/[0.1] font-mono">
                {cat.count}
              </span>
            </button>
          ))}
        </div>

        <!-- Match Cards Grid -->
        <div id="match-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {allMatches.map((match) => {
            const isLive = match.status === 'LIVE';
            const isFt = match.status === 'FT';
            const matchWaUrl = `https://wa.me/18036582620?text=G%27day%21+I+want+to+stream+${encodeURIComponent(match.homeTeam)}+vs+${encodeURIComponent(match.awayTeam)}+(${encodeURIComponent(match.league)})+live+in+4K+on+AU+IPTV.`;

            return (
              <article 
                class="match-item bg-[#0D0D14] rounded-2xl p-6 border border-white/[0.08] hover:border-[#059669]/60 hover:shadow-[0_0_30px_rgba(5,150,105,0.2)] transition-all duration-300 flex flex-col justify-between group relative overflow-hidden"
                data-sport={match.sport}
                data-match-id={match.id}
              >
                <!-- Subtle Gradient Glow on Hover -->
                <div class="absolute inset-0 bg-gradient-to-br from-[#059669]/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

                <div class="relative z-10">
                  <!-- Match Header -->
                  <div class="flex items-center justify-between pb-3.5 border-b border-white/[0.06] mb-4">
                    <span class="text-xs font-bold text-gray-300 uppercase tracking-wider flex items-center gap-1.5 font-mono">
                      <span>{match.sportBadge}</span>
                      {match.isRealApi && (
                        <span class="text-[9px] bg-[#059669]/20 text-[#34D399] px-1.5 py-0.5 rounded font-mono font-semibold">LIVE API</span>
                      )}
                    </span>

                    {isLive ? (
                      <span class="flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-500/15 border border-red-500/30 text-red-400 text-[10px] font-black uppercase tracking-wider font-mono">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                        <span class="match-time">{match.timeDetail}</span>
                      </span>
                    ) : isFt ? (
                      <span class="px-2 py-0.5 rounded-md bg-white/[0.05] text-gray-400 text-[10px] font-bold uppercase tracking-wider font-mono">
                        {match.timeDetail}
                      </span>
                    ) : (
                      <span class="px-2.5 py-0.5 rounded-md bg-[#059669]/15 text-[#34D399] text-[10px] font-bold uppercase tracking-wider font-mono flex items-center gap-1">
                        <Clock class="w-3 h-3 text-[#FDE047]" />
                        <span>{match.timeDetail}</span>
                      </span>
                    )}
                  </div>

                  <!-- Teams & Scores -->
                  <div class="space-y-3 mb-4">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2.5 truncate">
                        <div class="w-2.5 h-2.5 rounded-full bg-[#10B981] shrink-0"></div>
                        <span class="text-base font-bold text-white group-hover:text-[#34D399] transition-colors truncate">
                          {match.homeTeam}
                        </span>
                      </div>
                      {match.homeScore !== undefined ? (
                        <span class="team-score text-lg font-black text-[#FDE047] font-mono bg-white/[0.06] border border-white/[0.08] px-3 py-0.5 rounded-lg">
                          {match.homeScore}
                        </span>
                      ) : (
                        <span class="text-xs text-gray-500 font-mono">VS</span>
                      )}
                    </div>

                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2.5 truncate">
                        <div class="w-2.5 h-2.5 rounded-full bg-gray-500 shrink-0"></div>
                        <span class="text-base font-bold text-white group-hover:text-[#34D399] transition-colors truncate">
                          {match.awayTeam}
                        </span>
                      </div>
                      {match.awayScore !== undefined && (
