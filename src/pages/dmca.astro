---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { FileText } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<Layout
  title={`DMCA & Copyright Policy — AU IPTV Australia ${currentYear}`}
  description="DMCA notification and copyright infringement procedures for AU IPTV Australia. Compliance with international copyright treaties and Australian intellectual property standards."
  canonicalURL="https://au-iptv.net/dmca/"
>
  <StickyHeader currentPath="/dmca" />

  <main class="flex-1 py-16 sm:py-24 bg-[#060609]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="mb-12 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-4">
          <FileText class="w-3.5 h-3.5 text-[#FDE047]" />
          <span>Intellectual Property Compliance</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
          DMCA & Copyright Notice
        </h1>
        <p class="text-xs sm:text-sm text-gray-400">
          Last Updated: September {currentYear} • AU IPTV Australia (au-iptv.net)
        </p>
      </div>

      <!-- Legal Content Box -->
      <div class="rounded-3xl bg-[#0D0D14] border border-white/[0.08] p-8 sm:p-12 space-y-8 text-gray-300 text-sm leading-relaxed">
        
        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">1.</span> Notice of Content Routing & Intermediary Role
          </h2>
          <p class="mb-3">
            AU IPTV operates as a digital communications routing provider and platform conduit. We do not host, store, broadcast, or transmit copyrighted media files on our web servers. The website <code>au-iptv.net</code> acts strictly as a point of contact, subscription coordination portal, and informational technical guide for digital streaming applications.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">2.</span> Respect for Copyright & Takedown Protocol
          </h2>
          <p class="mb-3">
            AU IPTV respects the intellectual property rights of creators, rights holders, and broadcasters globally. In accordance with the <em>Digital Millennium Copyright Act (17 U.S.C. § 512)</em> and the <em>Copyright Act 1968 (Cth)</em>, we will respond expeditiously to legitimate, documented notices of alleged copyright infringement.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">3.</span> Filing a Copyright Infringement Notice
          </h2>
          <p class="mb-3">
            To submit a valid copyright takedown request, the copyright owner or their authorized agent must provide a written communication containing the following:
          </p>
          <ul class="list-disc pl-6 space-y-2 text-gray-400">
            <li>Physical or electronic signature of a person authorized to act on behalf of the copyright owner.</li>
            <li>Clear identification of the copyrighted work claimed to have been infringed.</li>
            <li>Identification of the material or URL link on our site that is claimed to be infringing and that is to be removed.</li>
            <li>Sufficient contact information including your full legal name, physical address, telephone number, and official corporate email address.</li>
            <li>A statement that the complaining party has a good faith belief that the disputed use is not authorized by the copyright owner, its agent, or the law.</li>
            <li>A statement, made under penalty of perjury, that the information in the notification is accurate.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">4.</span> Designated Copyright Agent
          </h2>
          <p class="mb-4">
            All formal copyright inquiries and statutory notices must be directed to our designated agent:
          </p>
          <div class="p-5 rounded-2xl bg-white/[0.03] border border-white/[0.06] space-y-2 text-xs">
            <p><strong>Designated Agent:</strong> AU IPTV Intellectual Property & Legal Compliance</p>
            <p><strong>Email:</strong> <a href="mailto:contact@au-iptv.net" class="text-[#34D399] hover:underline">contact@au-iptv.net</a> / <a href="mailto:support@castvera.com" class="text-[#FDE047] hover:underline">support@castvera.com</a></p>
            <p><strong>Response Turnaround:</strong> Typically reviewed and acknowledged within 48 business hours.</p>
          </div>
        </section>

      </div>
    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
