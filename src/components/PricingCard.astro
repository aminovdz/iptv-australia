---
import { Check, Sparkles, ShieldCheck, MessageCircle, Zap } from 'lucide-astro';

interface Plan {
  id: string;
  name: string;
  duration: string;
  price: string;
  monthlyEquivalent: string;
  savings?: string;
  featured?: boolean;
  popularBadge?: string;
  bonus?: string;
  features: string[];
  ctaText: string;
  whatsappMessage: string;
}

// Strict Rule: Always start the pricing table/cards with the 12-month plan prominently displayed
const plans: Plan[] = [
  {
    id: "12-months",
    name: "12 Months + Premium Player Included",
    duration: "12 Months Pass",
    price: "90",
    monthlyEquivalent: "Only $7.50 AUD / month",
    savings: "BONUS: Licensed Premium Player App Included · Best Value",
    featured: true,
    popularBadge: "MOST POPULAR IN AUSTRALIA",
    bonus: "Special Aussie Bonus: High-Speed Premium Player App Activated Free!",
    features: [
      "Licensed Premium Player app included (worth $25 AUD)",
      "Ultra HD 4K & 8K streaming at native 60 FPS",
      "Anti-Freeze 9.8™ zero-buffering server architecture",
      "Interactive 7-day catch-up TV & live electronic program guide (EPG)",
      "All live Aussie sports (NRL, AFL, Cricket, A-League) & global events",
      "Optimized for NBN broadband & 4G/5G mobile connections",
      "Instant activation via WhatsApp or email within 2 minutes",
      "2 simultaneous connections for your household",
      "Priority 24/7 technical support in AEST",
      "Strict 24-hour money-back satisfaction guarantee"
    ],
    ctaText: "Get 12-Month Pass ($90 AUD)",
    whatsappMessage: "G%27day%21+I+would+like+to+order+the+12+Months+AU+IPTV+Plan+for+90+AUD+with+the+free+Premium+Player."
  },
  {
    id: "6-months",
    name: "6 Months + Premium Player Included",
    duration: "6 Months Pass",
    price: "50",
    monthlyEquivalent: "Only $8.33 AUD / month",
    savings: "BONUS: Premium Player App Included",
    featured: false,
    popularBadge: "GREAT VALUE",
    bonus: "Special Bonus: Premium Player Application Included!",
    features: [
      "Licensed Premium Player app included free",
      "Crystal clear 4K Ultra HD & Full HD 60 FPS feeds",
      "Anti-Freeze 9.8™ technology for uninterrupted sports",
      "7-day catch-up TV for international kick-offs & races",
      "Live NRL, AFL, Summer Cricket & international cups",
      "Compatible with Samsung/LG Smart TVs, Fire Stick, iOS & Android",
      "Instant 2-minute activation via WhatsApp",
      "24/7 dedicated customer assistance in AEST",
      "Strict 24-hour money-back satisfaction guarantee"
    ],
    ctaText: "Get 6-Month Pass ($50 AUD)",
    whatsappMessage: "G%27day%21+I+would+like+to+order+the+6+Months+AU+IPTV+Plan+for+50+AUD+with+the+Premium+Player."
  },
  {
    id: "3-months",
    name: "3 Months Subscription",
    duration: "3 Months Pass",
    price: "33",
    monthlyEquivalent: "Only $11.00 AUD / month",
    savings: "Flexible Quarterly Streaming",
    featured: false,
    features: [
      "Full HD & 4K Ultra HD streaming quality",
      "Anti-Freeze 9.8™ server stability",
      "Complete live sports & entertainment coverage",
      "Interactive EPG program guide",
      "Fast setup on all standard IPTV applications",
      "Instant activation via WhatsApp or email",
      "7-day weekly technical support",
      "Strict 24-hour money-back satisfaction guarantee"
    ],
    ctaText: "Get 3-Month Pass ($33 AUD)",
    whatsappMessage: "G%27day%21+I+would+like+to+order+the+3+Months+AU+IPTV+Plan+for+33+AUD."
  },
  {
    id: "1-month",
    name: "1 Month Starter",
    duration: "1 Month Pass",
    price: "13",
    monthlyEquivalent: "$13.00 AUD / month",
    savings: "No Lock-in Contracts",
    featured: false,
    features: [
      "High quality Full HD & 4K streams",
      "Anti-Freeze 9.8™ network protection",
      "Access to all live sports & PPV events",
      "Full EPG program schedules",
      "Works on any smart TV, phone, or streaming box",
      "Instant automated setup",
      "Standard customer support",
      "Strict 24-hour money-back satisfaction guarantee"
    ],
    ctaText: "Get 1-Month Pass ($13 AUD)",
    whatsappMessage: "G%27day%21+I+would+like+to+order+the+1+Month+AU+IPTV+Plan+for+13+AUD."
  }
];

const trialUrl = "https://wa.me/213550592200?text=G%27day%21+I+would+like+to+test+the+free+24h+trial+before+ordering.";
---

<section id="pricing" class="py-20 md:py-28 relative bg-[#060609] overflow-hidden" aria-labelledby="pricing-heading">
  <!-- Ambient Gold & Emerald Glow -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[900px] h-[400px] bg-gradient-to-r from-[#059669]/15 via-[#D97706]/10 to-[#059669]/15 rounded-full blur-[150px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/35 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#FDE047]" />
        <span>Transparent Australian Pricing</span>
      </div>
      <h2 id="pricing-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4">
        Choose Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">AU IPTV</span> Subscription Plan
      </h2>
      <p class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal">
        All plans include unthrottled 4K 60FPS streaming, Anti-Freeze 9.8™ technology, and dedicated Australian server routing. No hidden hardware fees, no lock-in contracts.
      </p>

      <!-- Pay-TV Comparison Box -->
      <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#0D0D14] border border-white/[0.08] text-xs text-gray-300">
        <span class="text-red-400 line-through font-semibold">Typical Aussie Pay-TV: $120–$160/mo</span>
        <span class="text-gray-500">vs</span>
        <span class="text-[#34D399] font-black">AU IPTV Annual Pass: Only $7.50 AUD/mo</span>
      </div>
    </div>

    <!-- Pricing Cards Grid (12-Month Plan Prominently First) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6 items-stretch mb-16">
      {plans.map((plan) => {
        const isFeatured = plan.featured;
        return (
          <div
            class={`relative rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 ${
              isFeatured
                ? 'bg-gradient-to-b from-[#0D1F17] via-[#0D0D14] to-[#0D0D14] border-2 border-[#059669] shadow-[0_0_40px_rgba(5,150,105,0.3)] lg:-translate-y-2'
                : 'bg-[#0D0D14] border border-white/[0.08] hover:border-[#059669]/40 hover:bg-[#131320] hover:-translate-y-1'
            }`}
          >
            {isFeatured && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap">
                <span class="px-4 py-1.5 rounded-full bg-gradient-to-r from-[#059669] to-[#047857] text-white text-[11px] font-black uppercase tracking-wider shadow-lg flex items-center gap-1.5 border border-[#10B981]">
                  <Sparkles class="w-3.5 h-3.5 text-[#FDE047]" />
                  {plan.popularBadge}
                </span>
              </div>
            )}

            <div>
              <div class="mb-5">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">
                  {plan.duration}
                </span>
                <h3 class="text-lg font-black text-white leading-tight">
                  {plan.name}
                </h3>
              </div>

              <!-- Price Tag -->
              <div class="mb-6 p-4 rounded-2xl bg-white/[0.03] border border-white/[0.06]">
                <div class="flex items-baseline gap-1">
                  <span class="text-4xl sm:text-5xl font-black text-white tracking-tight">
                    ${plan.price}
                  </span>
                  <span class="text-sm font-bold text-gray-400">AUD</span>
                </div>
                <span class="text-xs font-bold text-[#34D399] block mt-1">
                  {plan.monthlyEquivalent}
                </span>
                {plan.savings && (
                  <span class="inline-block mt-2 text-[10px] font-bold text-[#FDE047] uppercase tracking-wide bg-[#D97706]/15 px-2 py-0.5 rounded border border-[#D97706]/30">
                    {plan.savings}
                  </span>
                )}
              </div>

              {plan.bonus && (
                <div class="mb-6 p-3 rounded-xl bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold flex items-center gap-2">
                  <Zap class="w-4 h-4 shrink-0 text-[#FDE047]" />
                  <span>{plan.bonus}</span>
                </div>
              )}

              <!-- Feature Checkpoints -->
              <ul class="space-y-3 mb-8 text-xs text-gray-300">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-2.5">
                    <div class="w-4 h-4 rounded-full bg-[#059669]/20 flex items-center justify-center shrink-0 mt-0.5 text-[#10B981]">
                      <Check class="w-3 h-3" />
                    </div>
                    <span class="leading-relaxed">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- CTA Order Button -->
            <div>
              <a
                href={`https://wa.me/213550592200?text=${plan.whatsappMessage}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl font-black text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] ${
                  isFeatured
                    ? 'bg-gradient-to-r from-[#059669] via-[#047857] to-[#059669] text-white shadow-[0_0_25px_rgba(5,150,105,0.45)] hover:shadow-[0_0_35px_rgba(5,150,105,0.7)] border border-[#10B981]'
                    : 'bg-[#18182A] hover:bg-[#059669] text-white border border-white/[0.12] hover:border-[#10B981]'
                }`}
                aria-label={`Order ${plan.name} on WhatsApp`}
              >
                <MessageCircle class="w-4 h-4 text-[#FDE047]" />
                <span>{plan.ctaText}</span>
              </a>
              <p class="text-[10px] text-gray-500 text-center mt-2.5 flex items-center justify-center gap-1">
                <ShieldCheck class="w-3 h-3 text-[#10B981]" />
                <span>24-Hour Refund Guarantee Included</span>
              </p>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Free Trial Banner -->
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#0D0D14] via-[#131320] to-[#0D0D14] border border-[#059669]/30 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <h3 class="text-xl font-bold text-white mb-1.5 flex items-center justify-center md:justify-start gap-2">
          <span>Unsure Which Plan Fits? Test It First 100% Free!</span>
        </h3>
        <p class="text-gray-400 text-xs sm:text-sm">
          Get a 24-hour test access on WhatsApp with full sports feeds, EPG, and 4K quality before subscribing.
        </p>
      </div>
      <a
        href={trialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl bg-gradient-to-r from-[#059669] to-[#047857] text-white text-xs font-black uppercase tracking-wider shadow-[0_0_25px_rgba(5,150,105,0.35)] hover:scale-105 transition-all shrink-0 border border-[#10B981]/50"
      >
        <MessageCircle class="w-4 h-4 text-[#FDE047]" />
        <span>Claim Free 24h Test</span>
      </a>
    </div>

  </div>
</section>
