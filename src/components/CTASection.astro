---
import { MessageCircle, CheckCircle2, ArrowRight, ShieldCheck, Zap } from 'lucide-astro';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
}

const {
  title = "Ready to Stop Overpaying for Aussie Sports & Entertainment?",
  subtitle = "Join over 1,840+ satisfied Australian households streaming NRL, AFL, Cricket, EPL, and global cinema in ultra-crisp 4K 60FPS. Set up in 2 minutes on any Smart TV or streaming device.",
  ctaText = "Start 24-Hour Free Trial"
} = Astro.props;

const whatsappUrl = "https://wa.me/18036582620?text=G%27day%21+I+would+like+to+test+the+free+24h+AU+IPTV+trial.";
---

<section class="py-20 relative overflow-hidden bg-[#060609]" aria-labelledby="cta-heading">
  <!-- Glowing Background Atmosphere -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-gradient-to-r from-[#059669]/25 via-[#D97706]/15 to-[#059669]/25 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative bg-gradient-to-br from-[#0D0D14] via-[#131320] to-[#0D0D14] rounded-3xl p-8 sm:p-12 md:p-16 border border-[#059669]/40 shadow-[0_15px_50px_rgba(0,0,0,0.8)] overflow-hidden">
      
      <!-- Top Decorative Accent -->
      <div class="absolute top-0 right-0 w-80 h-80 bg-gradient-to-bl from-[#059669]/20 via-transparent to-transparent pointer-events-none rounded-bl-full"></div>
      <div class="absolute bottom-0 left-0 w-60 h-60 bg-gradient-to-tr from-[#D97706]/15 via-transparent to-transparent pointer-events-none rounded-tr-full"></div>

      <div class="relative z-10 max-w-3xl mx-auto text-center">
        
        <!-- Live Offer Pill -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/35 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-6">
          <Zap class="w-3.5 h-3.5 text-[#FDE047]" />
          <span>Zero Risk · No Credit Card Required for Trial</span>
        </div>

        <h2 id="cta-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-[1.18] mb-6">
          {title}
        </h2>

        <p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
          {subtitle}
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#059669] via-[#047857] to-[#059669] text-white font-black text-sm uppercase tracking-wider shadow-[0_0_35px_rgba(5,150,105,0.45)] hover:shadow-[0_0_50px_rgba(5,150,105,0.7)] transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] border border-[#10B981]/50"
            aria-label="Start free 24-hour trial via WhatsApp"
          >
            <MessageCircle class="w-5 h-5 text-[#FDE047]" />
            <span>{ctaText}</span>
          </a>

          <a
            href="/#pricing"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-[#060609] hover:bg-[#0D0D14] text-white font-bold text-sm tracking-wide border border-white/[0.15] hover:border-[#D97706]/60 transition-all duration-300 hover:scale-[1.02]"
          >
            <span>Get 12-Month Plan ($90 AUD)</span>
            <ArrowRight class="w-4 h-4 text-[#FDE047]" />
          </a>
        </div>

        <!-- Trust Features Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-8 border-t border-white/[0.08] text-xs font-semibold text-gray-300">
          <div class="flex items-center justify-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-[#10B981] shrink-0" />
            <span>Instant Setup in 2 Min</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-[#10B981] shrink-0" />
            <span>NBN Compatible 60FPS</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <CheckCircle2 class="w-4 h-4 text-[#10B981] shrink-0" />
            <span>No Lock-In Contracts</span>
          </div>
          <div class="flex items-center justify-center gap-2">
            <ShieldCheck class="w-4 h-4 text-[#FDE047] shrink-0" />
            <span>24h Money-Back Guarantee</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
