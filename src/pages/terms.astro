---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { FileText } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<Layout
  title={`Terms of Service — AU IPTV Australia ${currentYear}`}
  description="Read the official terms and conditions for AU IPTV services. Australian Consumer Law provisions, subscription rules, and acceptable use policy."
  canonicalURL="https://au-iptv.net/terms/"
>
  <StickyHeader currentPath="/terms" />

  <main class="flex-1 py-16 sm:py-24 bg-[#060609]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Page Header -->
      <div class="mb-12 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-4">
          <FileText class="w-3.5 h-3.5 text-[#FDE047]" />
          <span>User Agreement & Conditions</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
          Terms of Service
        </h1>
        <p class="text-xs sm:text-sm text-gray-400">
          Effective Date: September {currentYear} • AU IPTV Australia (au-iptv.net)
        </p>
      </div>

      <!-- Legal Content Box -->
      <div class="rounded-3xl bg-[#0D0D14] border border-white/[0.08] p-8 sm:p-12 space-y-8 text-gray-300 text-sm leading-relaxed">
        
        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">1.</span> Acceptance of Terms & Australian Consumer Law
          </h2>
          <p class="mb-3">
            By purchasing, activating, or using an AU IPTV subscription or free trial, you agree to be bound by these Terms of Service. Nothing in these terms excludes, restricts, or modifies any consumer guarantees or rights that you have under the <em>Australian Consumer Law (ACL)</em> set out in Schedule 2 of the <em>Competition and Consumer Act 2010 (Cth)</em>.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">2.</span> Service Description & Delivery
          </h2>
          <p class="mb-3">
            AU IPTV provides digital streaming connectivity feeds accessible across compatible smart devices. Upon confirmed payment, your login credentials (M3U URL and Xtream Codes access) are delivered electronically via WhatsApp or email within 2 to 15 minutes.
          </p>
          <div class="p-4 rounded-xl bg-white/[0.03] border border-white/[0.06] text-xs space-y-1.5">
            <p><strong>12-Month Plan ($90 AUD):</strong> Includes 2 simultaneous household streams + licensed Premium Player application.</p>
            <p><strong>6-Month Plan ($50 AUD):</strong> Includes 1 active stream + licensed Premium Player application.</p>
            <p><strong>3-Month & 1-Month Plans ($33 / $13 AUD):</strong> Includes 1 active stream.</p>
          </div>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">3.</span> Multi-Connection & Account Sharing Policy
          </h2>
          <p>
            Subscriptions are intended for personal household use. Simultaneous streaming across more connections than your plan allows may result in temporary automated stream freezing. Reselling or distributing your private M3U URL publicly is strictly prohibited.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">4.</span> NBN Connection & Bandwidth Requirements
          </h2>
          <p>
            While our Anti-Freeze 9.8™ technology maximizes stability, seamless 4K 60FPS playback requires an adequate broadband connection (minimum 15 Mbps for HD, 25 Mbps for 4K). AU IPTV is not liable for stream buffering caused by local home Wi-Fi interference, ISP bandwidth throttles, or hardware deficiencies of end-user devices.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">5.</span> 24-Hour Refund Guarantee
          </h2>
          <p>
            We enforce a strict <strong>24-Hour Money-Back Guarantee</strong>. Because digital IPTV credentials provide instantaneous access to content, refund requests must be submitted in writing within 24 hours of account activation. Please refer to our dedicated <a href="/refund" class="text-[#34D399] underline font-semibold">Refund Policy</a> for full procedural details.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <span class="text-[#34D399]">6.</span> Contact & Legal Inquiries
          </h2>
          <p class="mb-2">For contract or legal questions:</p>
          <p class="text-xs text-gray-400">
            AU IPTV Legal Affairs • Email: <a href="mailto:contact@au-iptv.net" class="text-[#34D399]">contact@au-iptv.net</a> / <a href="mailto:support@castvera.com" class="text-[#FDE047]">support@castvera.com</a>
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
