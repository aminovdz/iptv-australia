---
import { MapPin, ArrowRight, Sparkles, Wifi } from 'lucide-astro';

const cities = [
  {
    name: "Sydney",
    slug: "sydney",
    state: "New South Wales (NSW)",
    latency: "< 12ms",
    sportsHighlight: "NRL Premiership, State of Origin & Premier League",
    serverNode: "Sydney Central NBN PoP"
  },
  {
    name: "Melbourne",
    slug: "melbourne",
    state: "Victoria (VIC)",
    latency: "< 14ms",
    sportsHighlight: "AFL Grand Final, Australian Open & F1 Grand Prix",
    serverNode: "Melbourne Docklands Edge"
  },
  {
    name: "Brisbane",
    slug: "brisbane",
    state: "Queensland (QLD)",
    latency: "< 18ms",
    sportsHighlight: "Brisbane Broncos, State of Origin & Summer Cricket",
    serverNode: "Brisbane Fortitude Node"
  },
  {
    name: "Perth",
    slug: "perth",
    state: "Western Australia (WA)",
    latency: "< 24ms",
    sportsHighlight: "West Coast AFL, Super Rugby & International Cricket",
    serverNode: "Perth Western Edge"
  },
  {
    name: "Adelaide",
    slug: "adelaide",
    state: "South Australia (SA)",
    latency: "< 19ms",
    sportsHighlight: "Adelaide Crows & Port Adelaide AFL, The Ashes",
    serverNode: "Adelaide Riverbank PoP"
  }
];
---

<section id="cities" class="py-20 md:py-28 relative bg-[#060609]" aria-labelledby="cities-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#FDE047]" />
        <span>Local Aussie Server Coverage</span>
      </div>
      <h2 id="cities-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4">
        Dedicated Streaming Across <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">All Australian Cities</span>
      </h2>
      <p class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal">
        By routing traffic through local Points of Presence in every state, AU IPTV reduces latency, eliminates ISP throttling, and guarantees broadcast-quality stability during high-demand sporting events.
      </p>
    </div>

    <!-- Cities Grid (Local SEO Landing Pages) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {cities.map((city) => (
        <a
          href={`/locations/${city.slug}`}
          class="bg-[#0D0D14] hover:bg-[#131320] rounded-2xl p-6 sm:p-7 border border-white/[0.08] hover:border-[#059669]/50 transition-all duration-300 group flex flex-col justify-between hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(5,150,105,0.2)]"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-[#059669]/15 border border-[#059669]/35 text-[#34D399] flex items-center justify-center group-hover:bg-[#059669] group-hover:text-white transition-colors">
                <MapPin class="w-5 h-5" />
              </div>
              <span class="text-[11px] font-bold text-[#34D399] bg-[#059669]/15 px-2.5 py-0.5 rounded border border-[#059669]/30 flex items-center gap-1 font-mono">
                <Wifi class="w-3 h-3" /> {city.latency}
              </span>
            </div>

            <h3 class="text-xl font-black text-white group-hover:text-[#34D399] transition-colors mb-1">
              AU IPTV {city.name}
            </h3>
            <span class="text-xs text-gray-400 font-semibold block mb-3">
              {city.state}
            </span>

            <p class="text-xs text-gray-400 leading-relaxed mb-4">
              Stream live {city.sportsHighlight} with local caching nodes on {city.serverNode}.
            </p>
          </div>

          <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs text-[#34D399] font-bold">
            <span>Explore {city.name} Plan</span>
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" />
          </div>
        </a>
      ))}

      <!-- Australia-Wide Regional Hub Card -->
      <div class="bg-gradient-to-br from-[#0D0D14] via-[#0D1F17] to-[#0D0D14] rounded-2xl p-6 sm:p-7 border border-[#059669]/40 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="w-10 h-10 rounded-xl bg-[#D97706]/20 border border-[#D97706]/40 text-[#FDE047] flex items-center justify-center">
              <MapPin class="w-5 h-5" />
            </div>
            <span class="text-[11px] font-bold text-[#FDE047] bg-[#D97706]/20 px-2.5 py-0.5 rounded border border-[#D97706]/35">
              Regional & Rural
            </span>
          </div>

          <h3 class="text-xl font-black text-white mb-1">
            Regional Australia & Starlink
          </h3>
          <span class="text-xs text-[#34D399] font-semibold block mb-3">
            Gold Coast, Newcastle, Canberra, Hobart & Rural
          </span>

          <p class="text-xs text-gray-400 leading-relaxed mb-4">
            Compatible with regional fixed wireless NBN, 4G/5G home broadband, and low-earth orbit Starlink connections with adaptive anti-jitter buffering.
          </p>
        </div>

        <div class="pt-4 border-t border-white/[0.06] text-xs text-gray-300 font-semibold flex items-center justify-between">
          <span>Nationwide 100% Coverage</span>
          <span class="text-[#10B981] font-bold">99.98% Active</span>
        </div>
      </div>
    </div>

  </div>
</section>
