---
import { MessageCircle, X, Clock, Gift, CheckCircle2, Sparkles, ArrowRight, ShieldCheck } from 'lucide-astro';

const whatsappOfferUrl = "https://wa.me/213550592200?text=G%27day%21+I+saw+the+exit+offer.+I+want+to+subscribe+and+claim+my+1+MONTH+FREE+bonus+after+my+subscription+%28Code%3A+BONUS-1M-FREE%29.";
---

<div
  id="exit-popup"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 backdrop-blur-md p-4 transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
  aria-describedby="exit-popup-desc"
>
  <div class="relative w-full max-w-lg rounded-3xl bg-gradient-to-b from-[#12241A] via-[#0D0D14] to-[#060609] border-2 border-[#059669] p-6 sm:p-8 shadow-[0_0_60px_rgba(5,150,105,0.45)] text-center transform scale-95 transition-transform duration-300 overflow-hidden">
    
    <!-- Top Ambient Glow -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-72 h-36 bg-[#059669]/35 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <!-- Close Button -->
    <button
      id="close-exit-popup"
      type="button"
      class="absolute top-4 right-4 p-2 rounded-full text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-[#059669]"
      aria-label="Close this special offer"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Gift Emblem -->
    <div class="mx-auto mb-4 w-16 h-16 rounded-2xl bg-gradient-to-br from-[#059669] to-[#047857] flex items-center justify-center shadow-[0_0_30px_rgba(5,150,105,0.55)] border border-[#10B981] relative">
      <Gift class="w-8 h-8 text-[#FDE047] animate-bounce" />
      <span class="absolute -top-1.5 -right-1.5 flex h-4 w-4">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FDE047] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-4 w-4 bg-[#FDE047]"></span>
      </span>
    </div>

    <!-- Urgency Badge -->
    <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#059669]/20 border border-[#059669]/40 text-[#34D399] text-[11px] font-black uppercase tracking-wider mb-2.5">
      <Clock class="w-3.5 h-3.5 text-[#FDE047]" />
      <span>Wait! Exclusive Exit Privilege</span>
    </div>

    <!-- Main Title -->
    <h2 id="exit-popup-title" class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-snug mb-2">
      Claim <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">1 Month FREE</span> After Your Subscription!
    </h2>

    <!-- Clear Value Proposition -->
    <p id="exit-popup-desc" class="text-xs sm:text-sm text-gray-200 leading-relaxed mb-4">
      Don’t leave empty-handed! Subscribe to <strong class="text-white">any AU IPTV plan today</strong>, and we will add <strong class="text-[#34D399] font-bold">1 FULL EXTRA MONTH (30 Days)</strong> completely free of charge to your active account.
    </p>

    <!-- Visual Example Callout Box -->
    <div class="bg-gradient-to-r from-[#059669]/15 via-[#0D0D14] to-[#059669]/15 rounded-2xl p-3 sm:p-3.5 border border-[#059669]/30 mb-4 text-xs">
      <div class="flex items-center justify-around text-center gap-2">
        <div class="flex-1">
          <span class="text-gray-400 block text-[10px] uppercase font-mono">1 Month Plan</span>
          <span class="text-white font-extrabold text-xs sm:text-sm">Get <span class="text-[#34D399]">2 Months</span></span>
        </div>
        <div class="text-[#FDE047] font-black text-base">+</div>
        <div class="flex-1">
          <span class="text-gray-400 block text-[10px] uppercase font-mono">12 Month Pass</span>
          <span class="text-white font-extrabold text-xs sm:text-sm">Get <span class="text-[#34D399]">13 Months</span></span>
        </div>
      </div>
    </div>

    <!-- 3-Step "How to Claim" Process -->
    <div class="bg-black/60 rounded-2xl p-4 border border-white/5 mb-5 text-left space-y-2.5">
      <div class="text-[11px] font-mono uppercase tracking-wider text-gray-400 font-bold mb-1 flex items-center gap-1.5">
        <Sparkles class="w-3.5 h-3.5 text-[#FDE047]" />
        <span>How To Claim Your Free Month:</span>
      </div>

      <div class="flex items-start gap-2.5 text-xs text-gray-300">
        <span class="w-5 h-5 rounded-full bg-[#059669]/25 text-[#34D399] font-black text-[11px] flex items-center justify-center shrink-0 border border-[#059669]/40">1</span>
        <span><strong>Select Any Plan:</strong> Choose 1, 3, 6, or 12 months (starts at just $13 AUD).</span>
      </div>

      <div class="flex items-start gap-2.5 text-xs text-gray-300">
        <span class="w-5 h-5 rounded-full bg-[#059669]/25 text-[#34D399] font-black text-[11px] flex items-center justify-center shrink-0 border border-[#059669]/40">2</span>
        <span><strong>Subscribe:</strong> Complete your quick order with instant WhatsApp activation.</span>
      </div>

      <div class="flex items-start gap-2.5 text-xs text-gray-300">
        <span class="w-5 h-5 rounded-full bg-[#059669]/25 text-[#34D399] font-black text-[11px] flex items-center justify-center shrink-0 border border-[#059669]/40">3</span>
        <span><strong>Claim +1 Month Free:</strong> Show code <code class="px-1.5 py-0.5 rounded bg-white/10 text-[#FDE047] font-mono font-bold">BONUS-1M-FREE</code> on WhatsApp and your account gets +30 days added immediately!</span>
      </div>
    </div>

    <!-- Guarantee Bullet Points -->
    <div class="flex items-center justify-center gap-4 text-[11px] text-gray-300 mb-5 flex-wrap">
      <span class="flex items-center gap-1">
        <CheckCircle2 class="w-3.5 h-3.5 text-[#10B981]" /> +30 Days Free Bonus
      </span>
      <span class="flex items-center gap-1">
        <CheckCircle2 class="w-3.5 h-3.5 text-[#10B981]" /> Instant WhatsApp Delivery
      </span>
      <span class="flex items-center gap-1">
        <ShieldCheck class="w-3.5 h-3.5 text-[#FDE047]" /> 24-Hour Guarantee
      </span>
    </div>

    <!-- CTA Button linking to WhatsApp -->
    <div class="flex flex-col gap-2.5">
      <a
        id="exit-popup-cta"
        href={whatsappOfferUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-gradient-to-r from-[#059669] via-[#047857] to-[#059669] text-white font-black text-sm uppercase tracking-wider shadow-[0_0_35px_rgba(5,150,105,0.6)] hover:shadow-[0_0_45px_rgba(5,150,105,0.8)] transition-all duration-300 hover:scale-[1.02] border border-[#10B981]"
      >
        <MessageCircle class="w-5 h-5 text-[#FDE047]" />
        <span>Claim My 1 Month Free on WhatsApp</span>
        <ArrowRight class="w-4 h-4 ml-0.5" />
      </a>

      <button
        id="dismiss-exit-popup"
        type="button"
        class="text-xs text-gray-400 hover:text-gray-200 transition-colors py-1 focus:outline-none"
      >
        No thanks, I'll pass on the 1 month free bonus after subscription
      </button>
    </div>

  </div>
</div>

<script>
  const STORAGE_KEY = 'au_iptv_exit_popup_24h_v2';
  const POPUP_COOLDOWN_MS = 24 * 60 * 60 * 1000; // Strictly once per 24 hours per user

  let exitPopupShown = false;
  const popup = document.getElementById('exit-popup');
  const closeBtn = document.getElementById('close-exit-popup');
  const dismissBtn = document.getElementById('dismiss-exit-popup');
  const ctaBtn = document.getElementById('exit-popup-cta');

  function isEligible(): boolean {
    if (exitPopupShown) return false;
    const lastDismissed = localStorage.getItem(STORAGE_KEY);
    if (!lastDismissed) return true;
    const elapsed = Date.now() - parseInt(lastDismissed, 10);
    return elapsed > POPUP_COOLDOWN_MS;
  }

  function showExitPopup() {
    if (!popup || !isEligible()) return;
    exitPopupShown = true;
    popup.classList.remove('hidden');
    popup.classList.add('flex');
    requestAnimationFrame(() => {
      popup.classList.remove('opacity-0');
      popup.classList.add('opacity-100');
      const inner = popup.querySelector('div.relative');
      if (inner) {
        inner.classList.remove('scale-95');
        inner.classList.add('scale-100');
      }
    });
  }

  function hideExitPopup() {
    if (!popup) return;
    localStorage.setItem(STORAGE_KEY, Date.now().toString());
    popup.classList.remove('opacity-100');
    popup.classList.add('opacity-0');
    const inner = popup.querySelector('div.relative');
    if (inner) {
      inner.classList.remove('scale-100');
      inner.classList.add('scale-95');
    }
    setTimeout(() => {
      popup.classList.remove('flex');
      popup.classList.add('hidden');
    }, 300);
  }

  // Trigger on desktop exit intent (cursor moves out top of viewport)
  document.addEventListener('mouseleave', (e) => {
    if (e.clientY <= 12 && isEligible()) {
      showExitPopup();
    }
  });

  // Trigger on mobile / touch exit intent (rapid scroll up after reaching down the page)
  let lastScrollY = window.scrollY;
  let maxScrollReached = 0;
  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    if (currentScrollY > maxScrollReached) {
      maxScrollReached = currentScrollY;
    }
    // If user scrolled past 400px, then suddenly scrolls up fast by > 120px towards top
    if (maxScrollReached > 400 && lastScrollY - currentScrollY > 120 && currentScrollY < 200 && isEligible()) {
      showExitPopup();
    }
    lastScrollY = currentScrollY;
  }, { passive: true });

  // Event Listeners for dismissal
  closeBtn?.addEventListener('click', hideExitPopup);
  dismissBtn?.addEventListener('click', hideExitPopup);
  ctaBtn?.addEventListener('click', hideExitPopup);

  // Close on backdrop click
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) {
      hideExitPopup();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && popup && !popup.classList.contains('hidden')) {
      hideExitPopup();
    }
  });
</script>
