---
import { Star, Tv, CheckCircle2, ArrowRight, MessageCircle } from 'lucide-astro';

interface Props {
  headline?: string;
  subheadline?: string;
  cityName?: string;
}

const {
  cityName,
  headline,
  subheadline = cityName
    ? `Experience the premier AU IPTV service in ${cityName} without locked contracts or expensive cable boxes. Stream live NRL, AFL, cricket, and global sports in ultra-smooth 4K 60FPS with Anti-Freeze 9.8™ technology and instant 2-minute activation on any screen.`
    : "Tired of paying $100+ AUD every month for fragmented sports apps and pay-TV packages? AU IPTV delivers ultra-high-definition 4K & 8K streaming with zero buffer delays, dedicated Australian routing servers, and complete sports & entertainment coverage."
} = Astro.props;

const whatsappTrialUrl = "https://wa.me/213550592200?text=G%27day%21+I+would+like+to+test+the+free+24h+AU+IPTV+trial.";
---

<section class="relative pt-8 pb-20 md:pt-16 md:pb-28 overflow-hidden" aria-labelledby="hero-title">
  <!-- Ambient Aussie Emerald & Gold Lighting -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[850px] h-[400px] bg-gradient-to-b from-[#059669]/15 via-[#D97706]/08 to-transparent rounded-full blur-[140px]"></div>
    <div class="absolute top-44 right-10 w-96 h-96 bg-[#059669]/10 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-10 left-10 w-80 h-80 bg-[#D97706]/08 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy & High-Weight Keyword Placement -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#0D0D14] border border-[#059669]/40 shadow-[0_0_20px_rgba(5,150,105,0.2)] mb-6">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#10B981]"></span>
          </span>
          <span class="text-xs font-semibold tracking-wide text-gray-200 flex items-center gap-1.5">
            <span class="text-[#34D399] font-bold">#1 Rated in Australia</span> · Dedicated Low-Latency Aussie Servers
          </span>
        </div>

        <!-- Single Page H1 Tag with Exact Primary Keyword Placement -->
        <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.12] mb-6">
          {headline ? (
            headline
          ) : cityName ? (
            <>
              AU IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">{cityName}</span> — Premier 4K Aussie Streaming
            </>
          ) : (
            <>
              <span class="text-white">Ditch the Pay-TV Rort.</span>{" "}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">
                AU IPTV
              </span>{" "}
              <span class="text-white block sm:inline">
                Streams All Sports in 4K
              </span>
            </>
          )}
        </h1>

        <!-- Primary Keyword within First 75-100 Words -->
        <p class="text-base sm:text-lg md:text-xl text-gray-300 font-normal leading-relaxed mb-8 max-w-2xl">
          {subheadline} With <strong>AU IPTV</strong>, you enjoy seamless broadcast stability powered by Anti-Freeze 9.8™ technology without lock-in contracts or expensive satellite equipment. Stream live NRL, AFL, cricket, EPL, motorsport, and global entertainment in native 4K 60FPS. Fast setup on Samsung & LG Smart TVs, Fire Stick, Apple TV, and mobile with 24/7 support in AEST.
        </p>

        <!-- Bullet Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mb-8 w-full max-w-xl">
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>4K/8K 60FPS streams with Anti-Freeze 9.8™</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>Premium Player included with 6 & 12-month plans</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>7-day catch-up TV for late-night & 3am kickoff games</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-gray-200">
            <CheckCircle2 class="w-5 h-5 text-[#10B981] shrink-0" />
            <span>NBN-optimized speeds & 24-hour refund guarantee</span>
          </div>
        </div>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-8">
          <a
            href={whatsappTrialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#059669] via-[#047857] to-[#059669] text-white font-black text-sm uppercase tracking-wider shadow-[0_0_30px_rgba(5,150,105,0.45)] hover:shadow-[0_0_45px_rgba(5,150,105,0.7)] transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] border border-[#10B981]/40"
            aria-label="Request free 24-hour AU IPTV trial on WhatsApp"
          >
            <MessageCircle class="w-5 h-5 text-[#FDE047]" />
            <span>Start 24-Hour Free Trial</span>
          </a>

          <a
            href="/#pricing"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-[#0D0D14] hover:bg-[#131320] text-white font-bold text-sm tracking-wide border border-white/[0.12] hover:border-[#059669]/60 transition-all duration-300 hover:scale-[1.02]"
          >
            <span>View Plans (From $13 AUD)</span>
            <ArrowRight class="w-4 h-4 text-[#34D399]" />
          </a>
        </div>

        <!-- Social Proof Metrics -->
        <div class="flex items-center gap-4 pt-4 border-t border-white/[0.08] w-full max-w-lg">
          <div class="flex -space-x-2 overflow-hidden">
            <span class="inline-block h-8 w-8 rounded-full ring-2 ring-[#060609] bg-emerald-700 text-[10px] font-bold text-center leading-8 text-white">LM</span>
            <span class="inline-block h-8 w-8 rounded-full ring-2 ring-[#060609] bg-amber-700 text-[10px] font-bold text-center leading-8 text-white">CH</span>
            <span class="inline-block h-8 w-8 rounded-full ring-2 ring-[#060609] bg-emerald-800 text-[10px] font-bold text-center leading-8 text-white">JT</span>
            <span class="inline-block h-8 w-8 rounded-full ring-2 ring-[#060609] bg-amber-800 text-[10px] font-bold text-center leading-8 text-white">DP</span>
          </div>
          <div class="flex flex-col">
            <div class="flex items-center gap-1 text-[#F59E0B]">
              {[...Array(5)].map(() => (
                <Star class="w-4 h-4 fill-current" />
              ))}
              <span class="text-white font-bold text-sm ml-1">4.92 / 5</span>
            </div>
            <span class="text-xs text-gray-400">Trusted by 1,840+ Aussies across Sydney, Melbourne & beyond</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Glassmorphic Stream Dashboard -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Glow & Glass Card -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-[#059669]/40 via-[#D97706]/30 to-[#059669]/40 rounded-3xl blur-xl opacity-75"></div>
          
          <div class="relative bg-[#0D0D14]/90 backdrop-blur-2xl rounded-3xl border border-white/[0.12] p-6 sm:p-8 shadow-2xl">
            
            <!-- Stream Header -->
            <div class="flex items-center justify-between pb-5 border-b border-white/[0.08] mb-6">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-[#059669]/20 border border-[#059669]/40 flex items-center justify-center">
                  <Tv class="w-5 h-5 text-[#34D399]" />
                </div>
                <div>
                  <h3 class="text-sm font-bold text-white">AU IPTV Live Ultra Stream</h3>
                  <p class="text-xs text-emerald-400 flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-[#10B981] animate-ping"></span> Live Broadcast · 4K UHD 60FPS
                  </p>
                </div>
              </div>
              <span class="px-2.5 py-1 rounded-md bg-[#D97706]/20 border border-[#D97706]/40 text-[#FDE047] text-[10px] font-black tracking-wider uppercase">
                Anti-Freeze 9.8™
              </span>
            </div>

            <!-- Sports Live Ticker List -->
            <div class="space-y-3 mb-6">
              <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/[0.06] flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="text-lg">🏉</span>
                  <div>
                    <h4 class="text-xs font-bold text-white">Aussie Rules & Rugby League</h4>
                    <p class="text-[11px] text-gray-400">Regular Season, Finals & State of Origin</p>
                  </div>
                </div>
                <span class="text-[11px] font-bold text-[#34D399] bg-[#059669]/15 px-2 py-0.5 rounded border border-[#059669]/30">4K Live</span>
              </div>

              <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/[0.06] flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="text-lg">🏏</span>
                  <div>
                    <h4 class="text-xs font-bold text-white">Cricket Australia & The Ashes</h4>
                    <p class="text-[11px] text-gray-400">Test Matches, Big Bash & International Cups</p>
                  </div>
                </div>
                <span class="text-[11px] font-bold text-[#34D399] bg-[#059669]/15 px-2 py-0.5 rounded border border-[#059669]/30">Zero Buffer</span>
              </div>

              <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/[0.06] flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="text-lg">⚽</span>
                  <div>
                    <h4 class="text-xs font-bold text-white">Premier League & European Football</h4>
                    <p class="text-[11px] text-gray-400">With 7-Day Catch-Up TV for 3 AM Kick-offs</p>
                  </div>
                </div>
                <span class="text-[11px] font-bold text-[#FDE047] bg-[#D97706]/15 px-2 py-0.5 rounded border border-[#D97706]/30">Catch-Up</span>
              </div>
            </div>

            <!-- Price Comparison Anchor Box -->
            <div class="p-4 rounded-2xl bg-gradient-to-br from-[#131320] to-[#0D0D14] border border-[#059669]/40 mb-6">
              <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-bold text-gray-300">Aussie Pay-TV Bundles:</span>
                <span class="text-xs text-red-400 line-through font-bold">$120–$160/mo</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-sm font-black text-white">AU IPTV 12-Month Pass:</span>
                <span class="text-base font-black text-[#34D399]">$7.50 AUD/mo</span>
              </div>
              <p class="text-[10px] text-gray-400 mt-2">Annual Pass ($90 AUD) includes free Premium Player app.</p>
            </div>

            <!-- Stream Performance Metrics -->
            <div class="grid grid-cols-3 gap-2 text-center pt-2">
              <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                <span class="block text-xs font-black text-white">99.98%</span>
                <span class="text-[10px] text-gray-400">Aussie Uptime</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                <span class="block text-xs font-black text-[#34D399]">&lt; 18ms</span>
                <span class="text-[10px] text-gray-400">Local Ping</span>
              </div>
              <div class="p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.04]">
                <span class="block text-xs font-black text-[#FDE047]">2 Min</span>
                <span class="text-[10px] text-gray-400">Fast Activation</span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
