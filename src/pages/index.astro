---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralBanner from '../components/ReferralBanner.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import LiveScores from '../components/LiveScores.astro';
import CitiesList from '../components/CitiesList.astro';
import ContactForm from '../components/ContactForm.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';

// Interactive Conversion & Retention Popups (24h localStorage Capped)
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

const currentYear = new Date().getFullYear();
---

<Layout
  title={`AU IPTV ${currentYear} — Australia's #1 4K/8K Streaming Service & Anti-Freeze 9.8™`}
  description="AU IPTV is Australia's premier streaming service. Watch NRL, AFL, Cricket, EPL & global cinema in 4K 60FPS with Anti-Freeze 9.8™ and local NBN servers. Instant 2-min activation."
  keywords={[
    'au iptv',
    'iptv australia',
    'iptv for australia',
    'best iptv australia',
    'iptv service',
    'cheap iptv australia',
    'iptv subscription australia',
    'nrl iptv streaming',
    'afl streaming 4k'
  ]}
  canonicalURL="https://au-iptv.net"
>
  <!-- Sticky Global Navigation -->
  <StickyHeader currentPath="/" />

  <!-- Main Content Sequence (Strict Required Order) -->
  <main id="main-content" class="flex-1 flex flex-col">
    <!-- 1. Hero Conversion Section -->
    <Hero />

    <!-- 2. Features Grid & Technological Edge -->
    <FeatureGrid />

    <!-- 3. Pricing Cards (12-Month Plan Prominently First) -->
    <PricingCard />

    <!-- 4. Viral Growth & Referral Rewards Banner -->
    <ReferralBanner />

    <!-- 5. Real Australian Testimonials & User Reviews -->
    <UserReviewsSection />

    <!-- 6. 4-Step Setup Process -->
    <ProcessSteps />

    <!-- 7. Supported Devices & Compatibility -->
    <SupportedDevices />

    <!-- 8. Real Sports Match Center & Broadcast Status -->
    <LiveScores />

    <!-- 9. Programmatic Local SEO (Australian Cities) -->
    <CitiesList />

    <!-- 10. Direct Contact Channels & Interactive Form -->
    <ContactForm />

    <!-- 11. FAQ Section with Google FAQPage Schema -->
    <FAQSection />

    <!-- 12. Bottom High-Urgency Call to Action -->
    <CTASection />
  </main>

  <!-- Global Footer -->
  <Footer />

  <!-- Engagement Popups & Widgets (24h LocalStorage Capped) -->
  <ExitPopup />
  <SocialPopup />
  <GroupsPopup />
  <FloatingWhatsApp />
</Layout>
