---
import { Tv, Sparkles, MessageCircle, Menu, X, ArrowRight } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Sports 4K', href: '/iptv-sports' },
  { name: 'Features', href: '/#features' },
  { name: 'Pricing', href: '/#pricing' },
  { name: '12-Month Pass', href: '/au-iptv-12-months' },
  { name: 'Devices', href: '/#devices' },
  { name: 'Guides & Blog', href: '/guides' },
  { name: 'Contact', href: '/contact' }
];

const whatsappUrl = "https://wa.me/18036582620?text=G%27day%21+I+would+like+to+test+the+free+24h+AU+IPTV+trial.";
---

<header class="sticky top-0 z-50 w-full transition-all duration-300 bg-[#060609]/95 backdrop-blur-xl border-b border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.7)]">
  <!-- Top Promotion Ticker -->
  <div class="bg-gradient-to-r from-[#059669]/20 via-[#D97706]/20 to-[#059669]/20 border-b border-[#059669]/30 text-center py-1.5 px-4 text-xs font-medium text-gray-200">
    <div class="flex items-center justify-center gap-2 max-w-7xl mx-auto flex-wrap sm:flex-nowrap">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-extrabold bg-[#059669] text-white uppercase tracking-wider">
        Aussie Special
      </span>
      <span class="text-gray-200 text-[11px] sm:text-xs">
        12 Months + Premium Player Included for only <strong class="text-[#FDE047] font-black">$90 AUD</strong> (~$7.50/mo) · Instant Activation 24/7!
      </span>
      <a href="/#pricing" class="inline-flex items-center gap-1 text-[#34D399] hover:text-white hover:underline font-bold ml-1 text-xs">
        View Plans <ArrowRight class="w-3 h-3" />
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#059669] rounded-lg p-1" aria-label="AU IPTV — Return to Homepage">
        <div class="relative w-11 h-11 rounded-xl bg-gradient-to-br from-[#131320] to-[#060609] border border-[#059669]/50 flex items-center justify-center shadow-[0_0_20px_rgba(5,150,105,0.35)] group-hover:border-[#10B981] transition-colors">
          <Tv class="w-5 h-5 text-[#10B981] group-hover:scale-110 transition-transform duration-300" />
          <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#10B981] ring-2 ring-[#060609] animate-pulse"></span>
        </div>
        <div class="flex flex-col">
          <span class="font-black text-xl tracking-tight text-white flex items-center gap-1.5">
            AU <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">IPTV</span>
          </span>
          <span class="text-[10px] font-semibold uppercase tracking-widest text-[#34D399] -mt-1 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10B981] inline-block"></span> 4K Ultra HD & Anti-Freeze 9.8™
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-all duration-200 ${
              currentPath === link.href
                ? 'text-[#34D399] bg-[#059669]/15 font-semibold'
                : 'text-gray-300 hover:text-white hover:bg-white/[0.04]'
            }`}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Action CTA -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#059669] via-[#047857] to-[#059669] text-white text-xs font-bold uppercase tracking-wider shadow-[0_0_20px_rgba(5,150,105,0.4)] hover:shadow-[0_0_30px_rgba(5,150,105,0.65)] transition-all duration-200 hover:scale-[1.02] border border-[#10B981]/40"
          aria-label="Contact WhatsApp Support to claim 24h free trial"
        >
          <MessageCircle class="w-4 h-4 text-[#FDE047]" />
          <span>Free 24h Trial</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center p-2 rounded-lg bg-[#059669]/20 border border-[#059669]/40 text-[#34D399] text-xs font-bold"
          aria-label="Contact via WhatsApp"
        >
          <MessageCircle class="w-4 h-4" />
        </a>
        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2.5 rounded-xl bg-[#0D0D14] border border-white/[0.08] text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#059669]"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open mobile navigation menu"
        >
          <Menu id="menu-icon-open" class="w-6 h-6 block" />
          <X id="menu-icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-nav"
    class="hidden lg:hidden border-t border-white/[0.08] bg-[#060609]/98 backdrop-blur-2xl transition-all duration-300"
    role="region"
    aria-label="Mobile Navigation Drawer"
  >
    <div class="px-4 pt-3 pb-6 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-xl text-base font-medium transition-colors ${
            currentPath === link.href
              ? 'text-[#34D399] bg-[#059669]/20 font-bold'
              : 'text-gray-300 hover:text-white hover:bg-white/[0.04]'
          }`}
        >
          {link.name}
        </a>
      ))}
      <div class="pt-4 border-t border-white/[0.06] flex flex-col gap-3">
        <a
          href="/#pricing"
          class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-[#D97706] to-[#B45309] text-white font-bold text-sm tracking-wide shadow-[0_0_20px_rgba(217,119,6,0.35)]"
        >
          <Sparkles class="w-4 h-4 text-[#FDE047]" />
          <span>View Pricing (From $13 AUD)</span>
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#0D0D14] border border-[#059669]/50 text-[#34D399] font-bold text-sm tracking-wide"
        >
          <MessageCircle class="w-4 h-4 text-[#10B981]" />
          <span>Instant WhatsApp Support & Trial</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileNav && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileNav.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    const links = mobileNav.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
