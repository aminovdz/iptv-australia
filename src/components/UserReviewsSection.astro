---
import { Star, MessageCircle, Sparkles, CheckCircle2 } from 'lucide-astro';

interface Review {
  name: string;
  city: string;
  state: string;
  rating: number;
  date: string;
  device: string;
  title: string;
  content: string;
  tag: string;
  verified: boolean;
}

const currentYear = new Date().getFullYear();

const reviews: Review[] = [
  {
    name: "Lachlan Mitchell",
    city: "Sydney",
    state: "NSW",
    rating: 5,
    date: `15 September ${currentYear}`,
    device: "Samsung 65\" 4K Smart TV",
    title: "Watched every State of Origin game without a single millisecond of buffer",
    content: "Normally during big NRL clashes our previous streaming provider would drop down to 480p or buffer endlessly right at the kickoff. AU IPTV was locked on 60 FPS in pristine 4K the entire 80 minutes. The Anti-Freeze technology is genuine dinkum. Cancelled expensive cable pay-TV and never looking back.",
    tag: "NRL & State of Origin",
    verified: true
  },
  {
    name: "Cameron Hayes",
    city: "Melbourne",
    state: "VIC",
    rating: 5,
    date: `2 September ${currentYear}`,
    device: "Amazon Fire Stick 4K Max",
    title: "Best AFL coverage and the 7-day catch-up TV is a lifesaver for 3 AM Premier League",
    content: "Living in Melbourne, footy is non-negotiable. AU IPTV gives me every AFL game plus full European football coverage. The best part is the catch-up TV: I don't have to stay awake until 3:30 AM to watch Arsenal; I just hit replay at breakfast and watch in Full HD.",
    tag: "AFL & EPL Catch-Up",
    verified: true
  },
  {
    name: "Jessica Taylor",
    city: "Brisbane",
    state: "QLD",
    rating: 5,
    date: `25 August ${currentYear}`,
    device: "LG OLED C3 & Apple TV 4K",
    title: "The included Premium Player app with the annual pass is super slick",
    content: "I took the 12-month plan for $90 AUD and the support team sent the activation for the Premium Player app immediately over WhatsApp. Setup took under 3 minutes. Clean TV guide, instantaneous zapping, and my partner can watch in the bedroom simultaneously.",
    tag: "Annual Pass & App Bonus",
    verified: true
  },
  {
    name: "Dean Papadopoulos",
    city: "Adelaide",
    state: "SA",
    rating: 5,
    date: `18 August ${currentYear}`,
    device: "Sony Bravia Google TV",
    title: "Multicultural channels plus all Aussie sports in one subscription",
    content: "Our household wanted Australian cricket and footy, but my parents also wanted Greek television channels (ERT, Mega). AU IPTV gives us both seamlessly over our standard NBN 50 connection with zero stutter. Saves us over $100 a month compared to expensive cable bundles.",
    tag: "Multicultural & Sports",
    verified: true
  },
  {
    name: "Markus Van Der Berg",
    city: "Perth",
    state: "WA",
    rating: 5,
    date: `10 August ${currentYear}`,
    device: "Chromecast with Google TV",
    title: "Perth ping is genuinely low — no delay on live motorsport & Super Rugby",
    content: "In Western Australia we usually get the worst internet lag from eastern state servers. AU IPTV must have a local WA routing node because live motorsport and rugby start in less than a second with crisp audio and zero lag.",
    tag: "Low-Latency Perth Node",
    verified: true
  },
  {
    name: "Chloe Harrison",
    city: "Gold Coast",
    state: "QLD",
    rating: 5,
    date: `28 July ${currentYear}`,
    device: "iPad Pro & Fire TV",
    title: "Customer support on WhatsApp answered me in 90 seconds on a Sunday",
    content: "Had a small question about updating the EPG schedule on my Fire Stick. Sent a WhatsApp message on Sunday evening and an Australian-based agent sorted it out within two minutes with clear screenshot steps. Top notch service.",
    tag: "24/7 AEST Support",
    verified: true
  }
];

const trialUrl = "https://wa.me/18036582620?text=G%27day%21+I+saw+the+positive+reviews+and+want+to+test+the+free+24h+trial.";
---

<section id="reviews" class="py-20 md:py-28 relative bg-[#060609]" aria-labelledby="reviews-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#FDE047]" />
        <span>Verified Aussie Testimonials</span>
      </div>
      <h2 id="reviews-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4">
        What Real Australian Subscribers <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">Say About Us</span>
      </h2>
      <p class="text-gray-300 text-base sm:text-lg leading-relaxed font-normal">
        From State of Origin in Sydney to AFL Grand Finals in Melbourne and cricket tests across the country, discover how Aussies enjoy buffer-free streaming every day.
      </p>

      <!-- Rating Summary Strip -->
      <div class="mt-6 inline-flex flex-wrap items-center justify-center gap-4 p-4 rounded-2xl bg-[#0D0D14] border border-white/[0.08]">
        <div class="flex items-center gap-1.5 text-[#F59E0B]">
          {[...Array(5)].map(() => (
            <Star class="w-5 h-5 fill-current" />
          ))}
        </div>
        <span class="text-white font-black text-lg">4.92 / 5.0</span>
        <span class="text-gray-500">•</span>
        <span class="text-gray-300 text-xs sm:text-sm font-semibold">Based on 1,840+ verified Australian customer ratings</span>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {reviews.map((item) => (
        <div class="bg-[#0D0D14] hover:bg-[#131320] rounded-2xl p-6 sm:p-7 border border-white/[0.08] hover:border-[#059669]/50 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <!-- Star Rating & Tag -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1 text-[#F59E0B]">
                {[...Array(item.rating)].map(() => (
                  <Star class="w-4 h-4 fill-current" />
                ))}
              </div>
              <span class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-[#059669]/10 text-[#34D399] border border-[#059669]/25">
                {item.tag}
              </span>
            </div>

            <h3 class="text-base font-bold text-white mb-2.5 group-hover:text-[#34D399] transition-colors leading-snug">
              "{item.title}"
            </h3>
            
            <p class="text-gray-400 text-xs sm:text-sm leading-relaxed mb-6">
              {item.content}
            </p>
          </div>

          <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between">
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-white">{item.name}</span>
                {item.verified && (
                  <CheckCircle2 class="w-3.5 h-3.5 text-[#10B981]" />
                )}
              </div>
              <span class="text-[11px] text-gray-500">
                {item.city}, {item.state} • {item.device}
              </span>
            </div>
            <span class="text-[10px] text-gray-600 font-mono">{item.date}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Social Proof CTA -->
    <div class="text-center">
      <a
        href={trialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#059669] via-[#047857] to-[#059669] text-white font-black text-xs uppercase tracking-wider shadow-[0_0_25px_rgba(5,150,105,0.4)] hover:scale-105 transition-all border border-[#10B981]/40"
      >
        <MessageCircle class="w-4 h-4 text-[#FDE047]" />
        <span>Join 1,840+ Happy Aussies — Start Free 24h Trial</span>
      </a>
    </div>

  </div>
</section>
