---
import { MessageCircle, Send, X, Bell, ExternalLink, Sparkles } from 'lucide-astro';

const whatsappChannelUrl = "https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v";
const telegramChannelUrl = "https://t.me/castvera_com";
---

<div
  id="groups-popup"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 transition-all duration-300 opacity-0"
  role="dialog"
  aria-modal="true"
  aria-labelledby="groups-popup-title"
>
  <div class="relative w-full max-w-md rounded-3xl bg-gradient-to-b from-[#14261C] via-[#0D0D14] to-[#060609] border-2 border-[#059669]/60 p-6 sm:p-8 shadow-[0_0_50px_rgba(5,150,105,0.4)] text-center transform scale-95 transition-transform duration-300 overflow-hidden">
    
    <!-- Close Button -->
    <button
      id="close-groups-popup"
      type="button"
      class="absolute top-4 right-4 p-2 rounded-full text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-[#059669]"
      aria-label="Close channels invitation"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Bell Icon Emblem -->
    <div class="mx-auto mb-4 w-14 h-14 rounded-2xl bg-[#059669]/20 border border-[#059669]/50 flex items-center justify-center shadow-[0_0_20px_rgba(5,150,105,0.4)]">
      <Bell class="w-7 h-7 text-[#34D399]" />
    </div>

    <!-- Live Status Pill -->
    <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full bg-[#059669]/20 border border-[#059669]/40 text-[#34D399] text-[11px] font-black uppercase tracking-wider mb-2">
      <Sparkles class="w-3 h-3 text-[#FDE047]" />
      <span>Official Australian Broadcast Channels</span>
    </div>

    <h2 id="groups-popup-title" class="text-xl sm:text-2xl font-black text-white tracking-tight mb-2">
      Never Miss a Big Aussie Match
    </h2>

    <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6 font-normal">
      Join our official community broadcast channels for real-time kickoff reminders (NRL, AFL, Ashes & EPL), server status updates, and members-only discounts.
    </p>

    <!-- Channels Action Buttons -->
    <div class="flex flex-col gap-3 mb-4">
      <a
        href={whatsappChannelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2.5 py-3.5 px-5 rounded-xl bg-[#25D366]/20 hover:bg-[#25D366]/30 text-[#25D366] border border-[#25D366]/40 text-xs font-bold uppercase tracking-wider transition-all"
        id="groups-whatsapp-btn"
      >
        <MessageCircle class="w-4 h-4 text-[#25D366]" />
        <span>Join WhatsApp Broadcast Channel</span>
        <ExternalLink class="w-3 h-3 opacity-70 ml-1" />
      </a>

      <a
        href={telegramChannelUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2.5 py-3.5 px-5 rounded-xl bg-[#0088cc]/20 hover:bg-[#0088cc]/30 text-[#29b6f6] border border-[#0088cc]/40 text-xs font-bold uppercase tracking-wider transition-all"
        id="groups-telegram-btn"
      >
        <Send class="w-4 h-4 text-[#29b6f6]" />
        <span>Join Telegram VIP Channel</span>
        <ExternalLink class="w-3 h-3 opacity-70 ml-1" />
      </a>
    </div>

    <button
      id="dismiss-groups-popup"
      type="button"
      class="text-[11px] text-gray-400 hover:text-gray-200 transition-colors py-1"
    >
      I'll join later
    </button>

  </div>
</div>

<script>
  const STORAGE_KEY = 'au_iptv_groups_popup_24h_v1';
  const COOLDOWN_MS = 24 * 60 * 60 * 1000;

  const popup = document.getElementById('groups-popup');
  const closeBtn = document.getElementById('close-groups-popup');
  const dismissBtn = document.getElementById('dismiss-groups-popup');
  const waBtn = document.getElementById('groups-whatsapp-btn');
  const tgBtn = document.getElementById('groups-telegram-btn');

  function isEligible(): boolean {
    const dismissedAt = localStorage.getItem(STORAGE_KEY);
    if (!dismissedAt) return true;
    return Date.now() - parseInt(dismissedAt, 10) > COOLDOWN_MS;
  }

  function showPopup() {
    if (!popup || !isEligible()) return;
    popup.classList.remove('hidden');
    popup.classList.add('flex');
    requestAnimationFrame(() => {
      popup.classList.remove('opacity-0');
      popup.classList.add('opacity-100');
      const inner = popup.querySelector('div.relative');
      if (inner) {
        inner.classList.remove('scale-95');
        inner.classList.add('scale-100');
      }
    });
  }

  function hidePopup() {
    if (!popup) return;
    localStorage.setItem(STORAGE_KEY, Date.now().toString());
    popup.classList.remove('opacity-100');
    popup.classList.add('opacity-0');
    const inner = popup.querySelector('div.relative');
    if (inner) {
      inner.classList.remove('scale-100');
      inner.classList.add('scale-95');
    }
    setTimeout(() => {
      popup.classList.remove('flex');
      popup.classList.add('hidden');
    }, 300);
  }

  closeBtn?.addEventListener('click', hidePopup);
  dismissBtn?.addEventListener('click', hidePopup);
  waBtn?.addEventListener('click', hidePopup);
  tgBtn?.addEventListener('click', hidePopup);

  popup?.addEventListener('click', (e) => {
    if (e.target === popup) hidePopup();
  });

  // Delayed trigger after 16 seconds on page
  if (isEligible()) {
    setTimeout(showPopup, 16000);
  }
</script>
