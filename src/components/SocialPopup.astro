---
import { CheckCircle2, Tv, X } from 'lucide-astro';
---

<div
  id="social-proof-toast"
  class="fixed bottom-6 left-6 z-40 hidden max-w-sm rounded-2xl bg-[#0D0D14]/95 backdrop-blur-xl border border-[#059669]/40 p-4 shadow-[0_10px_35px_rgba(0,0,0,0.8)] transition-all duration-300 opacity-0 transform translate-y-4"
  role="status"
  aria-live="polite"
>
  <button
    id="close-social-toast"
    type="button"
    class="absolute top-2 right-2 text-gray-400 hover:text-white p-1 rounded-lg focus:outline-none"
    aria-label="Dismiss recent activity notification"
  >
    <X class="w-3.5 h-3.5" />
  </button>

  <div class="flex items-start gap-3 pr-4">
    <div class="w-10 h-10 rounded-xl bg-[#059669]/20 border border-[#059669]/40 flex items-center justify-center shrink-0 text-[#34D399]">
      <Tv class="w-5 h-5" />
    </div>
    <div>
      <div class="flex items-center gap-1.5 mb-0.5">
        <span id="toast-name" class="text-xs font-bold text-white">Lachlan M.</span>
        <span class="text-[10px] text-gray-500">•</span>
        <span id="toast-city" class="text-[11px] text-[#34D399] font-semibold">Sydney, NSW</span>
      </div>
      <p id="toast-action" class="text-xs text-gray-300 leading-snug">
        Just ordered the 12-Month Pass + Premium Player
      </p>
      <div class="flex items-center gap-1.5 mt-1 text-[10px] text-gray-500">
        <CheckCircle2 class="w-3 h-3 text-[#10B981]" />
        <span id="toast-time">3 minutes ago</span>
        <span>•</span>
        <span class="text-emerald-400 font-semibold">Verified Aussie Order</span>
      </div>
    </div>
  </div>
</div>

<script>
  const STORAGE_KEY = 'au_iptv_social_popup_session_v1';
  const COOLDOWN_MS = 24 * 60 * 60 * 1000;

  const activities = [
    { name: "Lachlan M.", city: "Sydney, NSW", action: "Just ordered the 12-Month Pass + Premium Player", time: "3 minutes ago" },
    { name: "Cameron H.", city: "Melbourne, VIC", action: "Activated a 24-Hour Free Trial via WhatsApp", time: "7 minutes ago" },
    { name: "Jessica T.", city: "Brisbane, QLD", action: "Subscribed to the 6-Month Pass", time: "14 minutes ago" },
    { name: "Dean P.", city: "Adelaide, SA", action: "Renewed 12-Month Pass for family household", time: "22 minutes ago" },
    { name: "Markus V.", city: "Perth, WA", action: "Just ordered the 12-Month Pass + Premium Player", time: "31 minutes ago" },
    { name: "Chloe H.", city: "Gold Coast, QLD", action: "Requested 24-Hour Free Trial for Fire Stick", time: "44 minutes ago" }
  ];

  let currentIndex = 0;
  const toast = document.getElementById('social-proof-toast');
  const closeBtn = document.getElementById('close-social-toast');
  const nameEl = document.getElementById('toast-name');
  const cityEl = document.getElementById('toast-city');
  const actionEl = document.getElementById('toast-action');
  const timeEl = document.getElementById('toast-time');

  function isEligible(): boolean {
    const dismissedAt = localStorage.getItem(STORAGE_KEY);
    if (!dismissedAt) return true;
    return Date.now() - parseInt(dismissedAt, 10) > COOLDOWN_MS;
  }

  function showToast(activity: typeof activities[0]) {
    if (!toast || !isEligible()) return;
    if (nameEl) nameEl.textContent = activity.name;
    if (cityEl) cityEl.textContent = activity.city;
    if (actionEl) actionEl.textContent = activity.action;
    if (timeEl) timeEl.textContent = activity.time;

    toast.classList.remove('hidden');
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-4');
      toast.classList.add('opacity-100', 'translate-y-0');
    });

    setTimeout(() => {
      hideToast();
    }, 5500);
  }

  function hideToast() {
    if (!toast) return;
    toast.classList.remove('opacity-100', 'translate-y-0');
    toast.classList.add('opacity-0', 'translate-y-4');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 300);
  }

  closeBtn?.addEventListener('click', () => {
    hideToast();
    localStorage.setItem(STORAGE_KEY, Date.now().toString());
  });

  // Cycle notifications every 20-30 seconds if eligible
  if (isEligible()) {
    setTimeout(() => {
      showToast(activities[currentIndex]);
      setInterval(() => {
        if (!isEligible()) return;
        currentIndex = (currentIndex + 1) % activities.length;
        showToast(activities[currentIndex]);
      }, 25000);
    }, 6000);
  }
</script>
