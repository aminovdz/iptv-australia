---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import PricingCard from '../../components/PricingCard.astro';
import UserReviewsSection from '../../components/UserReviewsSection.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';

import ExitPopup from '../../components/ExitPopup.astro';
import SocialPopup from '../../components/SocialPopup.astro';
import GroupsPopup from '../../components/GroupsPopup.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';

import { 
  Scale, 
  ArrowRight, 
  ShieldCheck, 
  Zap, 
  DollarSign,
  TrendingDown
} from 'lucide-astro';

const comparisons = [
  {
    slug: "au-iptv-vs-iptvv-au",
    competitor: "IPTVV AU",
    highlight: "AU IPTV Anti-Freeze 9.8™ vs IPTVV AU Generic Cloud Server Peering",
    verdict: "AU IPTV delivers 50/60 FPS sports without buffering and includes a free player with the $90 AUD annual pass.",
    savings: "Save up to $50 AUD/yr"
  },
  {
    slug: "au-iptv-vs-aussie-iptv",
    competitor: "Aussie IPTV",
    highlight: "Modern Multi-Connection Protocol vs Older Legacy M3U Streams",
    verdict: "AU IPTV provides built-in ISP throttling protection across Australian broadband networks with 2 concurrent screens.",
    savings: "Better NBN Peering"
  },
  {
    slug: "au-iptv-vs-xtreme-tv-australia",
    competitor: "Xtreme TV Australia",
    highlight: "Direct Australian WhatsApp Support vs Delayed Overseas Ticket Queues",
    verdict: "AU IPTV offers live AEST customer assistance, transparent pricing, and robust matchday server uptime.",
    savings: "Save $40 - $60 AUD/yr"
  },
  {
    slug: "au-iptv-vs-traditional-cable",
    competitor: "Traditional Aussie Pay-TV",
    highlight: "Cord-Cutting: $90 AUD/Year vs $1,200 - $1,680 AUD/Year Cable Packages",
    verdict: "Ditch lock-in contracts, mandatory boxes, and sports fees. Stream on your own Fire Stick or Smart TV.",
    savings: "Save $1,200+ AUD/yr"
  }
];

const currentYear = new Date().getFullYear();
---

<Layout
  title={`IPTV Australia Comparisons ${currentYear} — AU IPTV vs Competitors & Pay-TV`}
  description="Explore honest, independent technical comparisons between AU IPTV and Australian streaming providers & legacy pay-TV cable packages. Find the best IPTV in Australia."
  keywords={[
    'iptv australia comparison',
    'best iptv australia',
    'au iptv vs iptvv au',
    'aussie iptv review',
    'pay tv alternative australia',
    'cord cutting australia'
  ]}
  canonicalURL="https://au-iptv.net/compare/"
>
  <StickyHeader currentPath="/compare" />

  <main id="main-content" class="flex-1 flex flex-col">
    <!-- Header Hero -->
    <section class="py-16 md:py-24 bg-gradient-to-b from-[#060609] via-[#0D0D14] to-[#060609] text-center relative overflow-hidden">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-6">
          <Scale class="w-3.5 h-3.5 text-[#FDE047]" />
          <span>Independent Technical Audits</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight mb-6">
          How Does <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">AU IPTV</span> Stack Up?
        </h1>

        <p class="text-gray-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed mb-8">
          We believe in complete transparency. Review our detailed head-to-head performance benchmarks against major Australian IPTV providers and traditional cable pay-TV services.
        </p>

        <!-- Cord cutting callout -->
        <div class="inline-flex items-center gap-3 px-5 py-3 rounded-2xl bg-[#059669]/10 border border-[#059669]/30 text-[#34D399] text-xs sm:text-sm font-semibold mb-10">
          <TrendingDown class="w-5 h-5 text-[#FDE047] shrink-0" />
          <span>Australian households save an average of $1,200 AUD per year switching to AU IPTV.</span>
        </div>

        <!-- Benchmark Infographic Graphic with High-Value Alt Text -->
        <div class="rounded-3xl overflow-hidden border border-white/[0.1] shadow-2xl relative max-w-4xl mx-auto">
          <img
            src="/images/guides/aussie-sports-crisis.webp"
            alt="AU IPTV vs Competitors Technical Benchmark and Cord-Cutting Economics in Australia"
            class="w-full h-auto max-h-[380px] object-cover"
            loading="eager"
            width="1200"
            height="630"
          />
        </div>

      </div>
    </section>

    <!-- Comparison Cards Directory -->
    <section class="py-16 bg-[#060609]" aria-label="Comparison Directory">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
          {comparisons.map((c) => (
            <div class="bg-[#0D0D14] rounded-2xl p-7 sm:p-8 border border-white/[0.08] hover:border-[#059669]/50 transition-all duration-300 flex flex-col justify-between group shadow-xl">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-mono text-[#34D399] bg-[#059669]/15 px-3 py-1 rounded-full font-bold">
                    {c.savings}
                  </span>
                  <span class="text-xs text-gray-500 font-mono">Head-to-Head</span>
                </div>

                <h2 class="text-2xl font-black text-white group-hover:text-[#34D399] transition-colors mb-2">
                  AU IPTV vs {c.competitor}
                </h2>

                <p class="text-xs sm:text-sm text-gray-300 font-medium mb-3">
                  {c.highlight}
                </p>

                <p class="text-xs text-gray-400 leading-relaxed mb-6">
                  {c.verdict}
                </p>
              </div>

              <div class="pt-5 border-t border-white/[0.06] flex items-center justify-between">
                <span class="text-xs font-bold text-gray-300">Read Full Audit</span>
                <a
                  href={`/compare/${c.slug}`}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-[#34D399] group-hover:translate-x-1 transition-transform"
                >
                  <span>Compare Specifications</span>
                  <ArrowRight class="w-4 h-4" />
                </a>
              </div>
            </div>
          ))}
        </div>

        <!-- 3 Core Advantages Summary -->
        <div class="bg-[#0B0B12] rounded-2xl p-8 sm:p-10 border border-white/[0.08] mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white text-center mb-8">
            The AU IPTV Technical Advantage
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <div class="space-y-3">
              <div class="w-12 h-12 rounded-xl bg-[#059669]/15 border border-[#059669]/40 flex items-center justify-center text-[#34D399]">
                <Zap class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-white">Anti-Freeze 9.8™ Load Balancing</h3>
              <p class="text-xs text-gray-400 leading-relaxed">
                Direct peering with Australian NBN Points of Interconnect (Sydney, Melbourne, Brisbane, Perth, Adelaide) prevents buffering during peak sports matches.
              </p>
            </div>

            <div class="space-y-3">
              <div class="w-12 h-12 rounded-xl bg-[#D97706]/15 border border-[#D97706]/40 flex items-center justify-center text-[#FDE047]">
                <DollarSign class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-white">Transparent AUD Pricing</h3>
              <p class="text-xs text-gray-400 leading-relaxed">
                No foreign exchange surprises. 12 Months for $90 AUD with a free premium player app included. Zero contracts and a 24-hour money-back guarantee.
              </p>
            </div>

            <div class="space-y-3">
              <div class="w-12 h-12 rounded-xl bg-[#059669]/15 border border-[#059669]/40 flex items-center justify-center text-[#34D399]">
                <ShieldCheck class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-white">Dedicated WhatsApp Support</h3>
              <p class="text-xs text-gray-400 leading-relaxed">
                Instant setup assistance and troubleshooting delivered directly in Australian Eastern Standard Time (+213 550 592 200).
              </p>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- Pricing Section -->
    <PricingCard />

    <!-- Reviews -->
    <UserReviewsSection />

    <!-- CTA Section -->
    <CTASection />
  </main>

  <Footer />

  <ExitPopup />
  <SocialPopup />
  <GroupsPopup />
  <FloatingWhatsApp />
</Layout>
