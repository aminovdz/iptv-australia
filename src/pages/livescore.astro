  <!-- Match Center Interactive Client Script (Filter Tabs + Real-Time Telemetry Clock & API Sync) -->
  <script is:inline>
    // 1. Australian Real-Time Telemetry Clock
    function updateAestClock() {
      const clockEl = document.getElementById("aest-clock");
      if (clockEl) {
        const now = new Date();
        const aestString = now.toLocaleTimeString("en-AU", {
          timeZone: "Australia/Sydney",
          hour12: false,
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit"
        });
        clockEl.textContent = `${aestString} AEST`;
      }
    }
    updateAestClock();
    setInterval(updateAestClock, 1000);

    // 2. Interactive Category Filter Tabs
    const filterTabs = document.querySelectorAll(".filter-tab");
    const matchItems = document.querySelectorAll(".match-item");

    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        // Update active tab styles
        filterTabs.forEach((t) => {
          t.classList.remove("active-tab", "bg-[#059669]", "text-white", "border-[#059669]", "shadow-[0_0_15px_rgba(5,150,105,0.3)]");
          t.classList.add("bg-[#0D0D14]", "text-gray-300", "border-white/[0.08]");
        });

        tab.classList.add("active-tab", "bg-[#059669]", "text-white", "border-[#059669]", "shadow-[0_0_15px_rgba(5,150,105,0.3)]");
        tab.classList.remove("bg-[#0D0D14]", "text-gray-300", "border-white/[0.08]");

        const filterValue = tab.getAttribute("data-filter");

        matchItems.forEach((item) => {
          const itemSport = item.getAttribute("data-sport");
          if (filterValue === "all" || itemSport === filterValue) {
            item.style.display = "flex";
          } else {
            item.style.display = "none";
          }
        });
      });
    });

    // 3. Client-Side Real-Time Score Refresh for ESPN soccer fixtures
    async function refreshSoccerScores() {
      try {
        const res = await fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard");
        if (!res.ok) return;
        const data = await res.json();
        if (!data.events || !Array.isArray(data.events)) return;

        data.events.slice(0, 4).forEach((ev) => {
          const card = document.querySelector(`[data-match-id="real-${ev.id}"]`);
          if (card) {
            const comp = ev.competitions?.[0];
            const home = comp?.competitors?.find((c) => c.homeAway === "home") || comp?.competitors?.[0];
            const away = comp?.competitors?.find((c) => c.homeAway === "away") || comp?.competitors?.[1];
            const timeEl = card.querySelector(".match-time");
            if (timeEl && ev.status?.type?.shortDetail) {
              timeEl.textContent = ev.status.type.shortDetail;
            }
            const scoreEls = card.querySelectorAll(".team-score");
            if (scoreEls.length >= 2 && home && away) {
              if (home.score !== undefined) scoreEls[0].textContent = String(home.score);
              if (away.score !== undefined) scoreEls[1].textContent = String(away.score);
            }
          }
        });
      } catch (err) {
        // Silent fallback
      }
    }

    if (typeof window !== "undefined") {
      setTimeout(refreshSoccerScores, 2000);
      setInterval(refreshSoccerScores, 30000);
    }
  </script>
