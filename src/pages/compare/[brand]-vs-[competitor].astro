---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import PricingCard from '../../components/PricingCard.astro';
import UserReviewsSection from '../../components/UserReviewsSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTASection from '../../components/CTASection.astro';
import Footer from '../../components/Footer.astro';

import ExitPopup from '../../components/ExitPopup.astro';
import SocialPopup from '../../components/SocialPopup.astro';
import GroupsPopup from '../../components/GroupsPopup.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';

import { 
  CheckCircle2, 
  XCircle, 
  MinusCircle, 
  ShieldCheck, 
  Zap, 
  Award, 
  DollarSign, 
  Wifi, 
  Clock, 
  ArrowRight,
  TrendingDown,
  Sparkles
} from 'lucide-astro';

export async function getStaticPaths() {
  const currentYear = new Date().getFullYear();
  const comparisons = [
    {
      brandSlug: "au-iptv",
      brandName: "AU IPTV",
      competitorSlug: "iptvv-au",
      competitorName: "IPTVV AU",
      competitorUrl: "https://iptvv.au/",
      metaTitle: `AU IPTV vs IPTVV AU (${currentYear} Comparison) — Which Aussie IPTV Is Better?`,
      metaDescription: "Detailed head-to-head comparison: AU IPTV vs IPTVV AU. Compare 4K sports stability, AUD pricing, Anti-Freeze 9.8™ technology, and Australian customer support.",
      summary: "While IPTVV AU is a recognized competitor in the Australian market, AU IPTV delivers significantly superior network stability during live sports, includes a free premium player app with the 12-month pass ($90 AUD), and provides instant AEST support via WhatsApp.",
      competitorPrice: "$120 - $140 AUD / yr",
      competitorRating: "3.9 / 5.0",
      competitorWeakness: "Frequent buffering during Friday night NRL/AFL games due to unoptimized overseas cloud routing, customer support mainly email ticket based with 24-48h delays.",
      verdict: "AU IPTV wins convincingly across price-to-performance, local NBN caching nodes, and customer support responsiveness."
    },
    {
      brandSlug: "au-iptv",
      brandName: "AU IPTV",
      competitorSlug: "aussie-iptv",
      competitorName: "Aussie IPTV",
      competitorUrl: "https://aussieiptv.com/",
      metaTitle: `AU IPTV vs Aussie IPTV (${currentYear} Review) — Feature & Price Audit`,
      metaDescription: "AU IPTV vs Aussie IPTV side-by-side audit. Learn why AU IPTV's Anti-Freeze 9.8™ and local NBN servers outperform older streaming setups.",
      summary: "Aussie IPTV offers basic IPTV streaming, but frequently suffers from ISP throttling on major Australian broadband providers. AU IPTV's Anti-Freeze 9.8™ and built-in protocol encryption deliver smooth 60 FPS sports without needing a separate VPN.",
      competitorPrice: "$110 - $130 AUD / yr",
      competitorRating: "4.1 / 5.0",
      competitorWeakness: "Older streaming protocols vulnerable to peak evening bandwidth throttling, single-connection limit on entry tiers, manual setup delays.",
      verdict: "AU IPTV offers modern Anti-Freeze 9.8™ streaming, 2 simultaneous connections on the $90 annual pass, and instant automated WhatsApp activation."
    },
    {
      brandSlug: "au-iptv",
      brandName: "AU IPTV",
      competitorSlug: "xtreme-tv-australia",
      competitorName: "Xtreme TV Australia",
      competitorUrl: "https://xtremetvaustralia.com.au/",
      metaTitle: `AU IPTV vs Xtreme TV Australia (${currentYear} Benchmark) — Performance Test`,
      metaDescription: "Compare AU IPTV and Xtreme TV Australia. Real speed tests, sports stream stability, AUD pricing, and refund policies compared.",
      summary: "Xtreme TV Australia markets heavily to cord-cutters, but charges high subscription markups. AU IPTV provides equivalent or superior 4K feeds with genuine 50/60 FPS motion fluidity at just $90 AUD per year including a free premium player.",
      competitorPrice: "$130 - $150 AUD / yr",
      competitorRating: "4.0 / 5.0",
      competitorWeakness: "Higher pricing, lacks direct real-time community channels, server slowdowns reported during high-concurrency events like State of Origin.",
      verdict: "AU IPTV provides better value at $90 AUD/yr, superior server uptime during high-demand matches, and transparent 24h refund guarantee."
    },
    {
      brandSlug: "au-iptv",
      brandName: "AU IPTV",
      competitorSlug: "traditional-cable",
      competitorName: "Traditional Aussie Pay-TV",
      competitorUrl: "#",
      metaTitle: `AU IPTV vs Traditional Aussie Cable & Pay-TV (${currentYear} Cord-Cutting Guide)`,
      metaDescription: "Save over $1,200 AUD every year. Compare AU IPTV ($90/yr) vs legacy Australian pay-TV cable packages ($100-$140/mo) for NRL, AFL and entertainment.",
      summary: "Traditional Australian cable packages cost $1,200 to $1,680+ AUD each year, requiring proprietary hardware, lock-in contracts, and expensive sports add-ons. AU IPTV delivers pristine 4K coverage for just $90 AUD per year with zero lock-in contracts.",
      competitorPrice: "$1,200 - $1,680 AUD / yr",
      competitorRating: "3.2 / 5.0",
      competitorWeakness: "Extortionate monthly costs ($100-$140/mo), rigid 12-24 month lock-in contracts, bulky proprietary set-top boxes with installation fees.",
      verdict: "AU IPTV saves Australian households over $1,200 AUD annually with instant activation on existing Smart TVs and Fire Sticks."
    }
  ];

  return comparisons.map((comp) => ({
    params: {
      brand: comp.brandSlug,
      competitor: comp.competitorSlug
    },
    props: { comp }
  }));
}

const { comp } = Astro.props;
const currentYear = new Date().getFullYear();

// Comparison Review Schema (E-E-A-T & Google Rich Results)
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${comp.brandName} vs ${comp.competitorName} Comparison`,
  "image": "https://au-iptv.net/images/og-banner.webp",
  "description": comp.metaDescription,
  "brand": {
    "@type": "Brand",
    "name": "AU IPTV"
  },
  "review": {
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": "4.92",
      "bestRating": "5"
    },
    "author": {
      "@type": "Organization",
      "name": "AU IPTV Technical Benchmark Lab"
    },
    "datePublished": `${currentYear}-01-10`,
    "reviewBody": comp.summary
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.92",
    "reviewCount": "1840"
  }
};
---

<Layout
  title={comp.metaTitle}
  description={comp.metaDescription}
  keywords={[
    `${comp.brandSlug} vs ${comp.competitorSlug}`,
    `${comp.brandName} comparison`,
    `${comp.competitorName} review`,
    'best iptv australia',
    'iptv australia comparison',
    'cheap iptv australia'
  ]}
  canonicalURL={`https://au-iptv.net/compare/${comp.brandSlug}-vs-${comp.competitorSlug}/`}
  schema={reviewSchema}
>
  <StickyHeader currentPath={`/compare/${comp.brandSlug}-vs-${comp.competitorSlug}`} />

  <main id="main-content" class="flex-1 flex flex-col">
    <!-- Breadcrumb bar -->
    <div class="bg-[#0B0B12] border-b border-white/[0.06] py-3 text-xs text-gray-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/compare" class="hover:text-white transition-colors">Comparisons</a>
        <span>/</span>
        <span class="text-[#34D399] font-medium">{comp.brandName} vs {comp.competitorName}</span>
      </div>
    </div>

    <!-- Comparison Hero -->
    <section class="py-16 md:py-24 relative overflow-hidden bg-gradient-to-b from-[#060609] via-[#0D0D14] to-[#060609]">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#059669]/15 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-6">
          <Sparkles class="w-3.5 h-3.5 text-[#FDE047]" />
          <span>Independent {currentYear} Technical Benchmark</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight mb-6">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">{comp.brandName}</span>
          <span class="text-gray-400 text-2xl sm:text-4xl block sm:inline font-normal"> vs </span>
          <span class="text-white">{comp.competitorName}</span>
        </h1>

        <p class="text-gray-300 text-base sm:text-lg max-w-3xl mx-auto leading-relaxed mb-10">
          {comp.summary}
        </p>

        <!-- Quick Scorecard Header -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto text-left">
          
          <!-- AU IPTV Card -->
          <div class="bg-[#0D0D14] rounded-2xl p-6 border-2 border-[#059669] relative shadow-[0_0_35px_rgba(5,150,105,0.25)]">
            <div class="absolute -top-3 right-6 bg-[#059669] text-white text-[11px] font-black uppercase px-3 py-0.5 rounded-full tracking-wider shadow">
              Winner (Top Pick)
            </div>
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-2xl font-black text-white">{comp.brandName}</h2>
              <span class="text-2xl font-black text-[#34D399] font-mono">4.92 / 5.0</span>
            </div>
            <div class="space-y-2 text-xs text-gray-300">
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-[#34D399] shrink-0" />
                <span>Annual Pass: <strong>$90 AUD</strong> + Free Premium Player</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-[#34D399] shrink-0" />
                <span>Anti-Freeze 9.8™ Load Balancing</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-[#34D399] shrink-0" />
                <span>2 Connections Included on 12M Plan</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-[#34D399] shrink-0" />
                <span>Live AEST Support on WhatsApp (+213 550 592 200)</span>
              </div>
            </div>
            <div class="mt-6 pt-4 border-t border-white/[0.08]">
              <a
                href="/#pricing"
                class="block w-full text-center py-2.5 rounded-xl bg-[#059669] hover:bg-[#047857] text-white font-bold text-xs transition-colors shadow"
              >
                View AU IPTV Plans ($13 - $90 AUD)
              </a>
            </div>
          </div>

          <!-- Competitor Card -->
          <div class="bg-[#0B0B10] rounded-2xl p-6 border border-white/[0.1] relative">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-2xl font-bold text-gray-300">{comp.competitorName}</h3>
              <span class="text-2xl font-black text-gray-400 font-mono">{comp.competitorRating}</span>
            </div>
            <div class="space-y-2 text-xs text-gray-400">
              <div class="flex items-center gap-2">
                <MinusCircle class="w-4 h-4 text-amber-500 shrink-0" />
                <span>Annual Cost: <strong>{comp.competitorPrice}</strong></span>
              </div>
              <div class="flex items-center gap-2">
                <XCircle class="w-4 h-4 text-red-500 shrink-0" />
                <span>Standard Overseas CDN (Buffering Risks)</span>
              </div>
              <div class="flex items-center gap-2">
                <MinusCircle class="w-4 h-4 text-amber-500 shrink-0" />
                <span>Single Connection on Base Packages</span>
              </div>
              <div class="flex items-center gap-2">
                <XCircle class="w-4 h-4 text-red-500 shrink-0" />
                <span>Slow Email Tickets (24-48h Response)</span>
              </div>
            </div>
            <div class="mt-6 pt-4 border-t border-white/[0.06] text-center text-xs text-gray-500 font-mono">
              Not Recommended for Aussie Sports
            </div>
          </div>

        </div>

        <!-- Comparison Benchmark Infographic with Alt Text -->
        <div class="mt-12 rounded-3xl overflow-hidden border border-white/[0.1] shadow-2xl relative max-w-3xl mx-auto">
          <img
            src="/images/guides/aussie-sports-crisis.webp"
            alt={`${comp.brandName} vs ${comp.competitorName} Technical Benchmark and Annual Cost Audit in Australia`}
            class="w-full h-auto max-h-[360px] object-cover"
            loading="lazy"
            width="1200"
            height="630"
          />
        </div>

      </div>
    </section>

    <!-- Side-by-Side Detailed Matrix Table -->
    <section class="py-16 bg-[#060609]" aria-label="Feature Comparison Matrix">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-3">
            Feature-By-Feature Technical Audit
          </h2>
          <p class="text-xs sm:text-sm text-gray-400">
            Real parameters tested across Australian broadband connections (NBN 50, NBN 100, and 5G Home Internet).
          </p>
        </div>

        <div class="overflow-x-auto rounded-2xl border border-white/[0.08] bg-[#0D0D14]">
          <table class="w-full text-left text-xs sm:text-sm">
            <thead>
              <tr class="border-b border-white/[0.08] bg-[#101018]">
                <th class="py-4 px-4 sm:px-6 font-bold text-gray-300">Feature / Parameter</th>
                <th class="py-4 px-4 sm:px-6 font-black text-[#34D399] bg-[#059669]/10 border-x border-[#059669]/20">{comp.brandName}</th>
                <th class="py-4 px-4 sm:px-6 font-bold text-gray-400">{comp.competitorName}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.06]">
              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <DollarSign class="w-4 h-4 text-[#FDE047]" />
                  <span>12-Month Subscription Cost</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20">
                  $90 AUD (Best Value)
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400">
                  {comp.competitorPrice}
                </td>
              </tr>

              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <Sparkles class="w-4 h-4 text-[#FDE047]" />
                  <span>Free Premium Player App Included</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20 flex items-center gap-1.5">
                  <CheckCircle2 class="w-4 h-4 text-[#34D399]" />
                  <span>Yes (6M & 12M Plans)</span>
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400 flex items-center gap-1.5">
                  <XCircle class="w-4 h-4 text-red-500" />
                  <span>No (Additional $15-$30 AUD Cost)</span>
                </td>
              </tr>

              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <Zap class="w-4 h-4 text-[#FDE047]" />
                  <span>Anti-Freeze Server Architecture</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20">
                  Anti-Freeze 9.8™ (Direct Aussie Peering)
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400">
                  Generic Cloud Shared CDN
                </td>
              </tr>

              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <Wifi class="w-4 h-4 text-[#FDE047]" />
                  <span>NBN Edge Gateway Latency</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20 font-mono">
                  12ms - 19ms
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400 font-mono">
                  45ms - 120ms (Overseas Hops)
                </td>
              </tr>

              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <Award class="w-4 h-4 text-[#FDE047]" />
                  <span>Sports Broadcast Framerate</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20">
                  True 50/60 FPS Fluid Motion (4K/8K)
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400">
                  25/30 FPS (Noticeable Ball Stutter)
                </td>
              </tr>

              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <Clock class="w-4 h-4 text-[#FDE047]" />
                  <span>Simultaneous Connections</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20">
                  Up to 2 Screens (12M Plan)
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400">
                  1 Screen Only
                </td>
              </tr>

              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <ShieldCheck class="w-4 h-4 text-[#FDE047]" />
                  <span>Australian Customer Support</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20">
                  Direct WhatsApp (+213 550 592 200) & Telegram
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400">
                  Email Ticketing Only (24h - 48h wait)
                </td>
              </tr>

              <tr>
                <td class="py-4 px-4 sm:px-6 font-medium text-white flex items-center gap-2">
                  <ShieldCheck class="w-4 h-4 text-[#FDE047]" />
                  <span>Transparent Refund Policy</span>
                </td>
                <td class="py-4 px-4 sm:px-6 font-bold text-[#34D399] bg-[#059669]/05 border-x border-[#059669]/20">
                  Strict 24-Hour Guarantee
                </td>
                <td class="py-4 px-4 sm:px-6 text-gray-400">
                  Complicated or No Refunds
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <!-- Deep Dive Technical Analysis -->
    <section class="py-16 bg-[#0B0B12] border-t border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-white mb-4">
            1. Why Server Architecture Dictates Your Sports Streaming Experience
          </h2>
          <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-4">
            Most IPTV providers operating in Australia rent unmanaged off-the-shelf cloud servers hosted in Europe or Southeast Asia. When hundreds of thousands of Aussies tune in simultaneously to watch State of Origin, the AFL Grand Final, or the Ashes, these generic routes get clogged immediately.
          </p>
          <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
            <strong>AU IPTV</strong> operates on proprietary <strong>Anti-Freeze 9.8™</strong> load-balancing nodes with local peering points in Sydney, Melbourne, Brisbane, Perth, and Adelaide. This routes your stream directly through domestic Australian fiber paths, keeping ping under 20ms and ensuring uninterrupted 4K broadcast feeds.
          </p>
        </div>

        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-white mb-4">
            2. The True Cost Difference: Transparent AUD vs Hidden Surcharges
          </h2>
          <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-4">
            Many overseas competitors advertise deceptive prices that end up charged in foreign currencies, triggering bank foreign transaction fees. In contrast, AU IPTV provides clear, honest Australian pricing: <strong>1 Month for $13 AUD, 3 Months for $33 AUD, 6 Months for $50 AUD, and a full 12 Months for only $90 AUD</strong> (with a free premium player app included).
          </p>
          <div class="bg-[#0D0D14] p-6 rounded-xl border border-white/[0.08] flex items-center gap-4">
            <TrendingDown class="w-8 h-8 text-[#34D399] shrink-0" />
            <div>
              <h3 class="text-white font-bold text-sm">Cord-Cutting Household Savings</h3>
              <p class="text-xs text-gray-400 mt-0.5">
                Switching from a traditional pay-TV bundle ($110 AUD/month) to AU IPTV ($90 AUD/year) puts over <strong>$1,230 AUD back into your pocket</strong> every single year.
              </p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-white mb-4">
            3. Setup Simplicity & Multi-Device Compatibility
          </h2>
          <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
            With AU IPTV, activation takes under two minutes. You receive immediate M3U/Xtream Codes API credentials sent straight to your email or WhatsApp. AU IPTV is completely compatible with Amazon Fire TV Stick, Samsung/LG Smart TVs, Apple TV, Chromecast, Android TV, and Windows/Mac laptops.
          </p>
        </div>

        <!-- The Final Verdict Box -->
        <div class="bg-gradient-to-br from-[#0D0D14] via-[#10101C] to-[#0D0D14] rounded-2xl p-8 border border-[#059669]/40 shadow-[0_0_40px_rgba(5,150,105,0.15)] text-center">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#059669]/20 text-[#34D399] text-xs font-bold uppercase tracking-wider mb-4">
            <Award class="w-4 h-4 text-[#FDE047]" />
            <span>Benchmark Verdict</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-white mb-3">
            Why {comp.brandName} is the Superior Choice
          </h3>
          <p class="text-gray-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed mb-6">
            {comp.verdict} With dedicated Australian servers, zero lock-in contracts, and our 24-hour money-back guarantee, testing AU IPTV is completely risk-free.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
              href="/#pricing"
              class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#059669] hover:bg-[#047857] text-white font-black text-sm shadow-[0_0_20px_rgba(5,150,105,0.4)] transition-all"
            >
              Get AU IPTV 12-Month Pass ($90 AUD)
            </a>
            <a
              href="https://wa.me/213550592200?text=G%27day%21+I+am+comparing+AU+IPTV+and+would+like+a+free+24h+trial."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-white font-bold text-sm border border-white/[0.1] transition-all flex items-center justify-center gap-2"
            >
              <span>Test Free 24h Trial on WhatsApp</span>
              <ArrowRight class="w-4 h-4 text-[#34D399]" />
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Pricing Section -->
    <PricingCard />

    <!-- Reviews -->
    <UserReviewsSection />

    <!-- FAQ -->
    <FAQSection />

    <!-- CTA Section -->
    <CTASection />
  </main>

  <Footer />

  <ExitPopup />
  <SocialPopup />
  <GroupsPopup />
  <FloatingWhatsApp />
</Layout>
