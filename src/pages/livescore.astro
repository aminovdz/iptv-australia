---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';

// Interactive Conversion & Retention Popups (24h localStorage Capped)
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';
import GroupsPopup from '../components/GroupsPopup.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';

import { 
  Radio, 
  Trophy, 
  Clock, 
  MapPin, 
  ShieldCheck, 
  Zap, 
  ArrowRight, 
  Play
} from 'lucide-astro';

const currentYear = new Date().getFullYear();

interface MatchDetail {
  id: string;
  sport: 'nrl' | 'afl' | 'epl' | 'cricket' | 'ufc' | 'motorsport' | 'ucl';
  sportBadge: string;
  league: string;
  homeTeam: string;
  awayTeam: string;
  homeScore?: string;
  awayScore?: string;
  status: 'LIVE' | 'FT' | 'UPCOMING';
  timeDetail: string;
  venue: string;
  city: string;
  channel: string;
  bitrate: string;
  highlights?: string;
  isRealApi?: boolean;
}

// 1. Fetch live soccer scores from public ESPN API server-side
let realApiMatches: MatchDetail[] = [];

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 3500);

  const res = await fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard", {
    headers: { "User-Agent": "Mozilla/5.0 (compatible; AU-IPTV-MatchCenter/1.0)" },
    signal: controller.signal
  });
  clearTimeout(timeoutId);

  if (res.ok) {
    const data = await res.json();
    if (data.events && Array.isArray(data.events)) {
      realApiMatches = data.events.slice(0, 4).map((ev: any) => {
        const comp = ev.competitions?.[0];
        const home = comp?.competitors?.find((c: any) => c.homeAway === "home") || comp?.competitors?.[0];
        const away = comp?.competitors?.find((c: any) => c.homeAway === "away") || comp?.competitors?.[1];
        const state = ev.status?.type?.state;
        const isLive = state === "in";
        const isCompleted = ev.status?.type?.completed;

        return {
          id: `real-${ev.id}`,
          sport: 'epl' as const,
          sportBadge: "⚽ Premier League",
          league: "English Premier League",
          homeTeam: home?.team?.displayName || "Home Team",
          awayTeam: away?.team?.displayName || "Away Team",
          homeScore: home?.score !== undefined ? String(home.score) : undefined,
          awayScore: away?.score !== undefined ? String(away.score) : undefined,
          status: isLive ? 'LIVE' : (isCompleted ? 'FT' : 'UPCOMING'),
          timeDetail: ev.status?.type?.shortDetail || ev.status?.type?.description || "Scheduled",
          venue: comp?.venue?.fullName || "UK Stadium",
          city: comp?.venue?.address?.city || "England",
          channel: "Optus Sport 1 (4K UHD) • AU IPTV #201",
          bitrate: "4K UHD 60FPS • 24.5 Mbps",
          highlights: "Live English commentary & multi-cam replay available",
          isRealApi: true
        };
      });
    }
  }
} catch (e) {
  realApiMatches = [];
}

// 2. Comprehensive Verified Australian & Global Marquee Matches
const comprehensiveMatches: MatchDetail[] = [
  {
    id: "nrl-match-1",
