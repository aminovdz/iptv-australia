---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import PricingCard from '../../components/PricingCard.astro';
import UserReviewsSection from '../../components/UserReviewsSection.astro';
import CTASection from '../../components/CTASection.astro';

import ExitPopup from '../../components/ExitPopup.astro';
import SocialPopup from '../../components/SocialPopup.astro';
import GroupsPopup from '../../components/GroupsPopup.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';

import { getCollection, type CollectionEntry } from 'astro:content';
import { 
  Clock, 
  Calendar, 
  Tag, 
  ArrowLeft, 
  ArrowRight, 
  CheckCircle2, 
  ShieldCheck, 
  Sparkles, 
  BookOpen
} from 'lucide-astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content, headings } = await guide.render();

const currentYear = new Date().getFullYear();
const formatYear = (str: string) => str ? str.replace(/\b202[0-9]\b/g, String(currentYear)) : str;
const dynamicTitle = formatYear(guide.data.title);
const dynamicDescription = formatYear(guide.data.description);

const siteUrl = 'https://au-iptv.net';
const pageUrl = `${siteUrl}/guides/${guide.slug}/`;

// Structured Data for Google Articles / BlogPosting
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  },
  "headline": dynamicTitle,
  "description": dynamicDescription,
  "image": guide.data.image ? new URL(guide.data.image, siteUrl).toString() : `${siteUrl}/images/og-banner.webp`,
  "author": {
    "@type": "Organization",
    "name": guide.data.author,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "AU IPTV",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/favicon.svg`
    }
  },
  "datePublished": guide.data.pubDate.toISOString(),
  "dateModified": (guide.data.updatedDate || guide.data.pubDate).toISOString()
};
---

<Layout
  title={`${dynamicTitle} — AU IPTV Australia`}
  description={dynamicDescription}
  keywords={guide.data.tags}
  type="article"
  publishedTime={guide.data.pubDate.toISOString()}
  modifiedTime={(guide.data.updatedDate || guide.data.pubDate).toISOString()}
  canonicalURL={pageUrl}
  schema={articleSchema}
>
  <StickyHeader currentPath={`/guides/${guide.slug}`} />

  <main id="main-content" class="flex-1 flex flex-col">
    <!-- Breadcrumbs Navigation -->
    <div class="bg-[#0B0B12] border-b border-white/[0.06] py-3 text-xs text-gray-400">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 overflow-x-auto whitespace-nowrap">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <a href="/guides" class="hover:text-white transition-colors">Guides</a>
        <span>/</span>
        <span class="text-[#34D399] font-medium truncate max-w-[280px] sm:max-w-none">{dynamicTitle}</span>
      </div>
    </div>

    <!-- Article Header -->
    <header class="py-12 md:py-16 bg-gradient-to-b from-[#060609] via-[#0D0D14] to-[#060609] border-b border-white/[0.06]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#059669]/20 border border-[#059669]/30 text-[#34D399] text-xs font-bold uppercase tracking-wider">
            <Sparkles class="w-3.5 h-3.5 text-[#FDE047]" />
            {guide.data.category}
          </span>
          <span class="text-xs text-gray-400 flex items-center gap-1 font-mono">
            <Clock class="w-3.5 h-3.5" /> {guide.data.readingTime}
          </span>
          <span class="text-xs text-gray-400 flex items-center gap-1 font-mono">
            <Calendar class="w-3.5 h-3.5" /> {guide.data.pubDate.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
          </span>
        </div>

        <!-- Single # H1 Tag for Master SEO Structure -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-[1.18] mb-6">
          {dynamicTitle}
        </h1>

        <p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-6 font-normal">
          {dynamicDescription}
        </p>

        <!-- Author Byline -->
        <div class="flex items-center gap-3 pt-4 border-t border-white/[0.08]">
          <div class="w-10 h-10 rounded-full bg-[#059669]/20 border border-[#059669]/40 flex items-center justify-center text-[#34D399] font-bold text-sm">
            AU
          </div>
          <div>
            <span class="text-sm font-bold text-white block">{guide.data.author}</span>
            <span class="text-xs text-gray-400">Australian IPTV Streaming & Network Engineering Team</span>
          </div>
        </div>

      </div>
    </header>

    <!-- Main Article Body & Table of Contents -->
    <section class="py-12 bg-[#060609]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Table of Contents Card (If headings exist) -->
        {headings && headings.length > 0 && (
          <nav aria-label="Table of Contents" class="bg-[#0D0D14] rounded-2xl p-6 sm:p-7 border border-white/[0.08] mb-12 shadow-xl">
            <div class="flex items-center gap-2 mb-4 text-[#34D399] font-bold text-sm uppercase tracking-wider font-mono">
              <BookOpen class="w-4 h-4" />
              <span>Table of Contents</span>
            </div>
            <ul class="space-y-2 text-xs sm:text-sm">
              {headings
                .filter((h) => h.depth <= 3)
                .map((heading) => (
                  <li class={heading.depth === 3 ? "pl-4 text-gray-400" : "text-gray-300 font-medium"}>
                    <a
                      href={`#${heading.slug}`}
                      class="hover:text-[#34D399] transition-colors flex items-center gap-1.5"
                    >
                      <span class="text-[#059669]">›</span>
                      <span>{heading.text}</span>
                    </a>
                  </li>
                ))}
            </ul>
          </nav>
        )}

        <!-- Featured Hero Graphic with High-Weight Alt Text -->
        <div class="mb-12 rounded-3xl overflow-hidden border border-white/[0.1] shadow-2xl relative">
          <img
            src={guide.data.image}
            alt={guide.data.imageAlt}
            class="w-full h-auto max-h-[460px] object-cover"
            loading="eager"
            width="1200"
            height="630"
          />
        </div>

        <!-- Markdown Rendered Content Container -->
        <article class="prose prose-invert max-w-none 
          prose-headings:text-white prose-headings:font-black prose-headings:tracking-tight
          prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pt-6 prose-h2:border-t prose-h2:border-white/[0.08]
          prose-h3:text-xl prose-h3:mt-6 prose-h3:mb-3 prose-h3:text-[#34D399]
          prose-p:text-gray-300 prose-p:text-base prose-p:leading-relaxed prose-p:my-5
          prose-ul:my-5 prose-ul:space-y-2 prose-li:text-gray-300 prose-li:text-base
          prose-strong:text-white prose-strong:font-bold
          prose-a:text-[#34D399] prose-a:underline hover:prose-a:text-[#6EE7B7]
          prose-code:text-[#FDE047] prose-code:bg-white/[0.06] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono
          prose-blockquote:border-l-4 prose-blockquote:border-[#059669] prose-blockquote:bg-[#0D0D14] prose-blockquote:p-4 prose-blockquote:rounded-r-xl prose-blockquote:text-gray-300
        ">
          <Content />
        </article>

        <!-- Permanent High-Converting AU IPTV Solution Banner -->
        <aside aria-label="AU IPTV Recommendation" class="my-16 bg-gradient-to-br from-[#0D0D14] via-[#10101C] to-[#0D0D14] rounded-3xl p-8 sm:p-10 border-2 border-[#059669] relative shadow-[0_0_40px_rgba(5,150,105,0.25)] text-center sm:text-left overflow-hidden">
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
            
            <div class="sm:col-span-8 space-y-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#059669]/20 text-[#34D399] text-xs font-bold uppercase tracking-wider">
                <ShieldCheck class="w-3.5 h-3.5 text-[#FDE047]" />
                <span>The Tested #1 Solution for Australia</span>
              </div>
              <h3 class="text-2xl sm:text-3xl font-black text-white leading-tight">
                Stream Seamlessly with <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#10B981] via-[#FDE047] to-[#D97706]">AU IPTV</span>
              </h3>
              <p class="text-gray-300 text-sm leading-relaxed">
                Tired of buffering, missed sports goals, and high cable bills? AU IPTV features <strong>Anti-Freeze 9.8™</strong> technology, dedicated Australian NBN servers, and 4K 60FPS sports streaming starting at just <strong>$13 AUD</strong>. Get 12 Months for <strong>$90 AUD</strong> with a Free Premium Player included.
              </p>
              <div class="pt-2 flex flex-wrap items-center gap-3 text-xs text-gray-400">
                <span class="flex items-center gap-1"><CheckCircle2 class="w-4 h-4 text-[#34D399]" /> 24-Hour Refund Guarantee</span>
                <span class="flex items-center gap-1"><CheckCircle2 class="w-4 h-4 text-[#34D399]" /> Instant 2-Minute WhatsApp Setup</span>
              </div>
            </div>

            <div class="sm:col-span-4 flex flex-col gap-3 justify-center">
              <a
                href="/#pricing"
                class="w-full text-center px-6 py-3.5 rounded-xl bg-[#059669] hover:bg-[#047857] text-white font-black text-sm shadow-[0_0_20px_rgba(5,150,105,0.4)] transition-all"
              >
                View AU IPTV Plans
              </a>
              <a
                href="https://wa.me/213550592200?text=G%27day%21+I+am+reading+your+guide+and+would+like+to+test+the+free+24h+trial."
                target="_blank"
                rel="noopener noreferrer"
                class="w-full text-center px-4 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-white font-bold text-xs border border-white/[0.1] transition-all"
              >
                Chat on WhatsApp (+213 550 592 200)
              </a>
            </div>

          </div>
        </aside>

        <!-- Article Tags -->
        {guide.data.tags && (
          <div class="pt-6 border-t border-white/[0.08] flex flex-wrap items-center gap-2 mb-12">
            <span class="text-xs text-gray-400 font-mono flex items-center gap-1 mr-2">
              <Tag class="w-3.5 h-3.5" /> Tags:
            </span>
            {guide.data.tags.map((tag) => (
              <span class="text-xs bg-[#0D0D14] text-gray-300 px-3 py-1 rounded-lg border border-white/[0.08]">
                #{tag}
              </span>
            ))}
          </div>
        )}

        <!-- Back to Guides Link -->
        <div class="flex items-center justify-between pb-8">
          <a
            href="/guides"
            class="inline-flex items-center gap-2 text-xs font-bold text-[#34D399] hover:underline"
          >
            <ArrowLeft class="w-4 h-4" />
            <span>Back to All Guides</span>
          </a>
          <a
            href="/#pricing"
            class="inline-flex items-center gap-2 text-xs font-bold text-white hover:text-[#34D399]"
          >
            <span>Explore AU IPTV Pricing</span>
            <ArrowRight class="w-4 h-4" />
          </a>
        </div>

      </div>
    </section>

    <!-- Pricing Card Component -->
    <PricingCard />

    <!-- Reviews -->
    <UserReviewsSection />

    <!-- Bottom CTA -->
    <CTASection />
  </main>

  <Footer />

  <ExitPopup />
  <SocialPopup />
  <GroupsPopup />
  <FloatingWhatsApp />
</Layout>
